@{
    ViewData["Title"] = "Terms of Service";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-9">

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-5">

                <h2 class="fw-bold mb-1" style="color:#007A3D;">
                    BraysTech Mobile Management System Terms of Service
                </h2>

                <p class="text-muted mb-4">
                    Last updated:
                    @DateTime.Now.ToString("dd MMMM yyyy")
                </p>

                <p>
                    These Terms of Service govern the use of the
                    <strong>BraysTech Mobile Management System</strong>
                    operated by BraysTech Technologies ("we", "our",
                    "the platform").
                </p>

                <p>
                    By accessing and using this system, you confirm
                    that you are an authorised user and agree to
                    comply fully with these terms.
                </p>

                <hr class="my-4" />

                <!-- DEFINITIONS -->
                <h5 class="fw-bold mb-3">Definitions</h5>

                <p>
                    <strong>"System"</strong> refers to the BraysTech
                    Mobile Management System.<br />

                    <strong>"User"</strong> refers to any authorised
                    employee, manager, or administrator accessing
                    the platform.<br />

                    <strong>"Business"</strong> refers to the mobile
                    phone business using the platform.<br />

                    <strong>"BraysTech"</strong> refers to the
                    software provider and system owner.<br />

                    <strong>"Device"</strong> refers to mobile phones,
                    accessories, and electronic inventory managed
                    within the platform.
                </p>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3">
                    1. Authorised Access
                </h5>

                <p>
                    Access is restricted to authorised staff members only.
                    Unauthorised access, credential sharing, or attempts
                    to bypass permissions are strictly prohibited.
                </p>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3">
                    2. User Accounts
                </h5>

                <ul class="mb-4">
                    <li class="mb-2">
                        Every staff member must use their own account.
                    </li>

                    <li class="mb-2">
                        You are responsible for all activity under your account.
                    </li>

                    <li class="mb-2">
                        Login credentials must never be shared.
                    </li>

                    <li class="mb-2">
                        You must immediately report suspected unauthorised access.
                    </li>

                    <li class="mb-2">
                        Accounts remain property of the business.
                    </li>
                </ul>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3">
                    3. Sales & Financial Accuracy
                </h5>

                <p>
                    All sales, invoices, device records, customer details,
                    and payment records entered into the system must be
                    accurate and truthful.
                </p>

                <ul class="mb-4">
                    <li class="mb-2">
                        Fake transactions are strictly prohibited.
                    </li>

                    <li class="mb-2">
                        All M-Pesa, cash, bank, and financing payments
                        must reflect actual payments received.
                    </li>

                    <li class="mb-2">
                        Editing sales records without authorisation
                        is prohibited.
                    </li>

                    <li class="mb-2">
                        Fraudulent activity may lead to legal action.
                    </li>
                </ul>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3">
                    4. Inventory & Device Records
                </h5>

                <p>
                    Users are responsible for ensuring all phone inventory,
                    IMEI records, stock movements, pricing, and device
                    statuses are entered correctly.
                </p>

                <p>
                    Deliberately altering stock data, hiding inventory,
                    or creating fake stock entries is considered serious misconduct.
                </p>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3">
                    5. Audit Logs & Monitoring
                </h5>

                <p>
                    The system records and monitors actions including:
                </p>

                <ul class="mb-4">
                    <li class="mb-2">
                        Sales created or edited
                    </li>

                    <li class="mb-2">
                        Stock changes
                    </li>

                    <li class="mb-2">
                        Password resets
                    </li>

                    <li class="mb-2">
                        Staff role changes
                    </li>

                    <li class="mb-2">
                        Branch assignments
                    </li>

                    <li class="mb-2">
                        Login activity and account access
                    </li>
                </ul>

                <p>
                    By using this system, you consent to monitoring,
                    audit logging, and security tracking.
                </p>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3">
                    6. Role-Based Permissions
                </h5>

                <p>
                    Access to data and features is controlled through
                    role-based permissions assigned by administrators.
                </p>

                <p>
                    Attempting to access restricted sections or bypass
                    permissions is prohibited.
                </p>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3">
                    7. Confidentiality
                </h5>

                <p>
                    All customer information, sales reports, revenue data,
                    stock information, and employee information are confidential.
                </p>

                <p>
                    Users may not share system information externally
                    without authorisation.
                </p>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3">
                    8. System Security
                </h5>

                <ul class="mb-4">
                    <li class="mb-2">
                        Users must keep devices secure.
                    </li>

                    <li class="mb-2">
                        Users must log out from shared computers.
                    </li>

                    <li class="mb-2">
                        Malware, hacking attempts, or system abuse
                        are strictly prohibited.
                    </li>

                    <li class="mb-2">
                        Sessions may automatically expire for security purposes.
                    </li>
                </ul>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3">
                    9. Suspension & Termination
                </h5>

                <p>
                    Access may be suspended or permanently revoked if:
                </p>

                <ul class="mb-4">
                    <li class="mb-2">
                        These terms are violated
                    </li>

                    <li class="mb-2">
                        Fraudulent activity is detected
                    </li>

                    <li class="mb-2">
                        Employment ends
                    </li>

                    <li class="mb-2">
                        Management revokes access
                    </li>
                </ul>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3">
                    10. Limitation of Liability
                </h5>

                <p>
                    BraysTech is not liable for losses caused by:
                </p>

                <ul class="mb-4">
                    <li class="mb-2">
                        Internet downtime
                    </li>

                    <li class="mb-2">
                        Third-party payment failures
                    </li>

                    <li class="mb-2">
                        User negligence
                    </li>

                    <li class="mb-2">
                        Unauthorised credential sharing
                    </li>

                    <li class="mb-2">
                        External service outages
                    </li>
                </ul>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3">
                    11. Governing Law
                </h5>

                <p>
                    These terms are governed by the laws of Kenya,
                    including applicable data protection and
                    cybercrime regulations.
                </p>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3">
                    12. Contact Information
                </h5>

                <div class="card bg-light border-0 p-3 mt-2">

                    <p class="mb-1">
                        <strong>
                            BraysTech Technologies
                        </strong>
                    </p>

                    <p class="mb-1">
                        Nairobi, Kenya
                    </p>

                    <p class="mb-1">
                        Mobile Management Platform
                    </p>

                    <p class="mb-0">
                        Governed under Kenyan law and
                        data protection regulations.
                    </p>

                </div>

            </div>
        </div>

        <div class="text-center mb-4">
            <a href="/Dashboard/Index"
               class="btn btn-outline-secondary rounded-pill px-4">
                ← Back to Dashboard
            </a>
        </div>

    </div>
</div>