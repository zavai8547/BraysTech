@{
    ViewData["Title"] = "Staff Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var staff = ViewBag.Staff as BraysTech.Models.AppUser;
    var sales = ViewBag.Sales as
        IEnumerable<BraysTech.Models.PhoneSale>;
    var trend = ViewBag.Trend as IEnumerable<dynamic>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="/Performance/Index"
           class="btn btn-outline-secondary rounded-pill px-3">
            ← Back
        </a>
        <div style="width:52px;height:52px;border-radius:50%;
                    background:linear-gradient(135deg,#007A3D,#009648);
                    color:white;display:flex;align-items:center;
                    justify-content:center;font-weight:800;
                    font-size:1.2rem;">
            @string.Join("", staff!.FullName.Split(' ')
                     .Take(2).Select(w => w[0].ToString().ToUpper()))
        </div>
        <div>
            <h4 class="fw-bold mb-0">@staff.FullName</h4>
            <small class="text-muted">
                @staff.Email • @ViewBag.SelectedMonthName
            </small>
        </div>
    </div>
</div>

<!-- MONTH STATS -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm"
             style="border-radius:14px;
                    border-left:4px solid #007A3D !important;">
            <div class="card-body">
                <p class="text-muted small mb-1">Sales This Month</p>
                <h3 class="fw-bold mb-0"
                    style="color:#007A3D;">
                    @ViewBag.TotalSales
                </h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm"
             style="border-radius:14px;
                    border-left:4px solid #1d4ed8 !important;">
            <div class="card-body">
                <p class="text-muted small mb-1">Revenue</p>
                <h4 class="fw-bold mb-0" style="color:#1d4ed8;">
                    KES @((decimal)ViewBag.TotalRevenue).ToString("N0"))
                </h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm"
             style="border-radius:14px;
                    border-left:4px solid #b45309 !important;">
            <div class="card-body">
                <p class="text-muted small mb-1">Profit</p>
                <h4 class="fw-bold mb-0" style="color:#b45309;">
                    KES @((decimal)ViewBag.TotalProfit).ToString("N0"))
                </h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm"
             style="border-radius:14px;
                    border-left:4px solid #7c3aed !important;">
            <div class="card-body">
                <p class="text-muted small mb-1">Devices Sold</p>
                <h3 class="fw-bold mb-0" style="color:#7c3aed;">
                    @ViewBag.TotalDevices
                </h3>
            </div>
        </div>
    </div>
</div>

<!-- 6 MONTH TREND -->
<div class="card border-0 shadow-sm mb-4"
     style="border-radius:16px;overflow:hidden;">
    <div class="card-header bg-white border-0 pt-3 fw-bold"
         style="color:#007A3D;">
        📊 6 Month Trend
    </div>
    <div class="card-body">
        <div class="d-flex align-items-end gap-3"
             style="height:120px;">
            @if (trend != null)
            {
                var maxRev = 1m;
                foreach (var t in trend)
                {
                    decimal rev = (decimal)t.GetType()
                    .GetProperty("revenue").GetValue(t);
                    if (rev > maxRev) maxRev = rev;
                }
                foreach (var t in trend)
                {
                    var monthLabel = (string)t.GetType()
                    .GetProperty("month").GetValue(t);
                    decimal rev = (decimal)t.GetType()
                    .GetProperty("revenue").GetValue(t);
                    int salesCount = (int)t.GetType()
                    .GetProperty("sales").GetValue(t);
                    var pct = (double)(rev / maxRev * 100);
                    var barH = Math.Max(pct, 4);
                    <div style="flex:1;text-align:center;">
                        <div style="font-size:0.72rem;
                                     font-weight:700;
                                     color:#007A3D;
                                     margin-bottom:4px;">
                            @salesCount
                        </div>
                        <div style="height:@barH%;
                                     background:linear-gradient(
                                         180deg,#007A3D,#34d399);
                                     border-radius:6px 6px 0 0;
                                     min-height:4px;">
                        </div>
                        <div style="font-size:0.72rem;
                                     color:#888;
                                     margin-top:6px;">
                            @monthLabel
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- SALES LIST -->
<div class="card border-0 shadow-sm"
     style="border-radius:16px;overflow:hidden;">
    <div class="card-header bg-white border-0 pt-3 fw-bold"
         style="color:#007A3D;">
        🧾 Sales This Month (@ViewBag.TotalSales)
    </div>
    <div class="card-body p-0">
        @if (sales == null || !sales.Any())
        {
            <div class="text-center py-4 text-muted">
                No sales this month.
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead style="background:#007A3D;">
                    <tr>
                        <th style="color:white;padding:12px 16px;
                                   border:none;font-size:0.82rem;">
                            Date
                        </th>
                        <th style="color:white;padding:12px 16px;
                                   border:none;font-size:0.82rem;">
                            Customer
                        </th>
                        <th style="color:white;padding:12px 16px;
                                   border:none;font-size:0.82rem;">
                            Devices
                        </th>
                        <th style="color:white;padding:12px 16px;
                                   border:none;font-size:0.82rem;">
                            Payment
                        </th>
                        <th style="color:white;padding:12px 16px;
                                   border:none;font-size:0.82rem;">
                            Revenue
                        </th>
                        <th style="color:white;padding:12px 16px;
                                   border:none;font-size:0.82rem;">
                            Profit
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in sales)
                    {
                        <tr>
                            <td style="padding:12px 16px;
                                       font-size:0.85rem;">
                                @s.CreatedAt.ToString("dd MMM HH:mm")
                            </td>
                            <td style="padding:12px 16px;
                                       font-size:0.85rem;">
                                @(s.CustomerName ?? "Walk-in")
                            </td>
                            <td style="padding:12px 16px;">
                                @foreach (var item in s.Items)
                                {
                                    <span style="background:#f0f7f3;
                                                 color:#007A3D;
                                                 padding:2px 8px;
                                                 border-radius:6px;
                                                 font-size:0.75rem;
                                                 font-weight:600;
                                                 display:inline-block;
                                                 margin:1px;">
                                        @item.PhoneName
                                    </span>
                                }
                            </td>
                            <td style="padding:12px 16px;">
                                <span style="font-size:0.78rem;
                                             font-weight:700;">
                                    @s.PaymentMethod
                                </span>
                            </td>
                            <td style="padding:12px 16px;">
                                <strong style="color:#007A3D;">
                                    KES @s.TotalAmount.ToString("N0")
                                </strong>
                            </td>
                            <td style="padding:12px 16px;">
                                <strong style="color:#b45309;">
                                    KES @s.TotalProfit.ToString("N0")
                                </strong>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>