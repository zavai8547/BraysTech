@{
    ViewData["Title"] = "New Shop Sale";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"> New Shop Sale</h4>
    <a href="/Shop/Index" class="btn btn-outline-secondary rounded-pill px-3">
        ← Back to Shop
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">🛒 Select Products & Complete Sale</h5>
            </div>
            <div class="card-body">
                <form method="post" action="/Shop/NewSale" id="saleForm">
                    @Html.AntiForgeryToken()

                    <!-- PRODUCT SEARCH & CART -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold fs-6">
                            Search & Add Products
                        </label>
                        <!-- Search Box -->
                        <div class="input-group mb-3">
                            <span class="input-group-text bg-white"> </span>
                            <input type="text"
                                   id="productSearch"
                                   class="form-control form-control-lg"
                                   placeholder="Type product name to search..."
                                   autocomplete="off" />
                        </div>
                        <!-- Search Results Dropdown -->
                        <div id="searchResults"
                             class="card border shadow-sm mb-3"
                             style="display:none; max-height:280px;
                                    overflow-y:auto; position:relative;
                                    z-index:10;">
                            <div id="resultsList"></div>
                        </div>
                        <!-- Cart Items -->
                        <div id="cartItems">
                            <div class="text-muted text-center py-3"
                                 id="emptyCart">
                                <small>
                                    Search for a product above to add it to the sale
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Total -->
                    <div class="card bg-dark text-white p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fs-5">Total:</span>
                            <span class="fs-3 fw-bold" id="grandTotal">
                                KES 0
                            </span>
                        </div>
                    </div>

                    <!-- Payment Method -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold fs-6">
                            Payment Method
                        </label>
                        <div class="d-flex gap-3 flex-wrap">
                            <div class="form-check">
                                <input class="form-check-input" type="radio"
                                       name="paymentMethod" value="0"
                                       id="cash" checked
                                       onchange="toggleMpesa(false)" />
                                <label class="form-check-label" for="cash">
                                    Cash
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio"
                                       name="paymentMethod" value="1"
                                       id="mpesa"
                                       onchange="toggleMpesa(true)" />
                                <label class="form-check-label" for="mpesa">
                                    M-Pesa
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio"
                                       name="paymentMethod" value="2"
                                       id="card"
                                       onchange="toggleMpesa(false)" />
                                <label class="form-check-label" for="card">
                                    Card
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- M-Pesa Code -->
                    <div class="mb-4" id="mpesaDiv" style="display:none;">
                        <label class="form-label fw-semibold">
                            M-Pesa Confirmation Code
                        </label>
                        <input name="mpesaCode"
                               class="form-control text-uppercase"
                               placeholder="e.g. QHX4RT8K2P" />
                        <small class="text-muted">
                            Enter the code from customer's M-Pesa SMS
                        </small>
                    </div>

                    <!-- Notes -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Notes (optional)
                        </label>
                        <input name="notes" class="form-control"
                               placeholder="Any notes about this sale" />
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-3">
                        <button type="submit"
                                class="btn btn-success btn-lg flex-grow-1 rounded-pill"
                                id="submitBtn" disabled>
                            Complete Sale
                        </button>
                        <a href="/Shop/Index"
                           class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                            Cancel
                        </a>
                    </div>
                    <small class="text-muted mt-2 d-block text-center">
                        Add at least one product to complete the sale
                    </small>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- CSS Styles -->
<style>
    .product-result-item {
        padding: 12px 16px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
        transition: background 0.15s;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .product-result-item:last-child {
            border-bottom: none;
        }

        .product-result-item:hover {
            background: #f0f7ff;
        }

        .product-result-item.out-of-stock {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .cart-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: #f8f9fa;
        border-radius: 10px;
        margin-bottom: 8px;
        border: 1px solid #e9ecef;
    }

    .cart-product-name {
        flex: 1;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .cart-price {
        color: #1565C0;
        font-weight: 700;
        font-size: 0.9rem;
        min-width: 90px;
        text-align: right;
    }

    .qty-control {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .qty-btn {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 1px solid #dee2e6;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1;
        transition: all 0.15s;
    }

        .qty-btn:hover {
            background: #1565C0;
            color: white;
            border-color: #1565C0;
        }

    .qty-display {
        min-width: 32px;
        text-align: center;
        font-weight: 700;
        font-size: 0.95rem;
    }

    .remove-btn {
        background: none;
        border: none;
        color: #dc3545;
        cursor: pointer;
        font-size: 1rem;
        padding: 4px;
        border-radius: 4px;
        transition: background 0.15s;
    }

        .remove-btn:hover {
            background: #fef2f2;
        }
</style>

<script>
    // Product data from server
    const products = [
    @if (ViewBag.Products != null)
    {
        foreach (var p in (List<SplashCityCarwash.Models.Product>)ViewBag.Products)
        {
            <text>{
                    id: @p.ProductID,
                    name: "@Html.Raw(p.Name.Replace("\"", "\\\""))",
                    price: @p.SellingPrice,
                    stock: @p.CurrentStock,
                    unit: "@p.Unit"
                }, </text>
        }
    }
            ];

    // Cart state
    let cart = {};

    // ── SEARCH FUNCTIONALITY ──────────────────────────────
    const searchInput = document.getElementById('productSearch');
    const searchResults = document.getElementById('searchResults');
    const resultsList = document.getElementById('resultsList');

    searchInput.addEventListener('input', function () {
        const query = this.value.trim().toLowerCase();

        if (query.length < 1) {
            searchResults.style.display = 'none';
            return;
        }

        const matches = products.filter(p =>
            p.name.toLowerCase().includes(query)
        );

        if (matches.length === 0) {
            resultsList.innerHTML = `
                    <div class="p-3 text-muted text-center">
                        No products found for "${query}"
                    </div>`;
            searchResults.style.display = 'block';
            return;
        }

        resultsList.innerHTML = matches.map(p => `
                <div class="product-result-item ${p.stock <= 0 ? 'out-of-stock' : ''}"
                     onclick="${p.stock > 0 ? `addToCart(${p.id})` : ''}">
                    <div>
                        <div style="font-weight:600;font-size:0.9rem;">${p.name}</div>
                        <div style="font-size:0.75rem;color:#888;">
                            Stock: ${p.stock} ${p.unit}
                            ${p.stock <= 0 ? ' — <span style="color:#dc3545;">Out of stock</span>' : ''}
                        </div>
                    </div>
                    <div style="font-weight:700;color:#1565C0;">
                        KES ${p.price.toLocaleString()}
                    </div>
                </div>
            `).join('');

        searchResults.style.display = 'block';
    });

    // Hide search results when clicking outside
    document.addEventListener('click', function (e) {
        if (!searchInput.contains(e.target) &&
            !searchResults.contains(e.target)) {
            searchResults.style.display = 'none';
        }
    });

    // Add product to cart
    function addToCart(productId) {
        const product = products.find(p => p.id === productId);
        if (!product || product.stock <= 0) return;

        if (cart[productId]) {
            if (cart[productId].qty < product.stock) {
                cart[productId].qty++;
            }
        } else {
            cart[productId] = { product, qty: 1 };
        }

        // Clear search after adding
        searchInput.value = '';
        searchResults.style.display = 'none';
        renderCart();
    }

    // Change quantity
    function changeQty(productId, delta) {
        if (!cart[productId]) return;
        const newQty = cart[productId].qty + delta;
        const maxStock = cart[productId].product.stock;

        if (newQty <= 0) {
            removeFromCart(productId);
            return;
        }
        if (newQty > maxStock) {
            alert(`Only ${maxStock} ${cart[productId].product.unit} in stock`);
            return;
        }
        cart[productId].qty = newQty;
        renderCart();
    }

    // Remove from cart
    function removeFromCart(productId) {
        delete cart[productId];
        renderCart();
    }

    // Update custom price
    function updatePrice(productId, newPrice) {
        const price = parseFloat(newPrice);
        if (isNaN(price) || price < 0) return;

        if (cart[productId]) {
            cart[productId].customPrice = price;

            const subtotal = price * cart[productId].qty;
            const subtotalEl = document.getElementById(`subtotal_${productId}`);
            if (subtotalEl) {
                subtotalEl.textContent = 'KES ' + subtotal.toLocaleString();
            }

            let total = 0;
            Object.values(cart).forEach(item => {
                const p = item.customPrice || item.product.price;
                total += p * item.qty;
            });
            document.getElementById('grandTotal').textContent =
                'KES ' + total.toLocaleString();

            updateHiddenInputs();
        }
    }

    // Update hidden inputs for form submission
    function updateHiddenInputs() {
        document.querySelectorAll('.cart-input').forEach(el => el.remove());
        const form = document.getElementById('saleForm');

        Object.values(cart).forEach(item => {
            // Product ID
            const pidInput = document.createElement('input');
            pidInput.type = 'hidden';
            pidInput.name = 'productIDs';
            pidInput.value = item.product.id;
            pidInput.className = 'cart-input';
            form.appendChild(pidInput);

            // Quantity
            const qtyInput = document.createElement('input');
            qtyInput.type = 'hidden';
            qtyInput.name = 'quantities';
            qtyInput.value = item.qty;
            qtyInput.className = 'cart-input';
            form.appendChild(qtyInput);

            // Custom price
            const priceInput = document.createElement('input');
            priceInput.type = 'hidden';
            priceInput.name = 'customPrices';
            priceInput.value = item.customPrice || item.product.price;
            priceInput.className = 'cart-input';
            form.appendChild(priceInput);
        });
    }

    // Render cart
    function renderCart() {
        const cartContainer = document.getElementById('cartItems');
        const submitBtn = document.getElementById('submitBtn');

        const items = Object.values(cart);
        if (items.length === 0) {
            cartContainer.innerHTML = `
                    <div class="text-muted text-center py-3" id="emptyCart">
                        <small>Search for a product above to add it to the sale</small>
                    </div>`;
            document.getElementById('grandTotal').textContent = 'KES 0';
            submitBtn.disabled = true;
            return;
        }

        submitBtn.disabled = false;
        let total = 0;
        let html = '';

        items.forEach(item => {
            const unitPrice = item.customPrice || item.product.price;
            const subtotal = unitPrice * item.qty;
            total += subtotal;

            html += `
                    <div class="cart-row">
                        <div class="cart-product-name">
                            ${item.product.name}
                            <div style="font-size:0.75rem;color:#888;font-weight:400;">
                                Default: KES ${item.product.price.toLocaleString()}
                            </div>
                        </div>
                        <div class="qty-control">
                            <button type="button" class="qty-btn"
                                    onclick="changeQty(${item.product.id}, -1)">−</button>
                            <div class="qty-display">${item.qty}</div>
                            <button type="button" class="qty-btn"
                                    onclick="changeQty(${item.product.id}, 1)">+</button>
                        </div>
                        <!-- EDITABLE PRICE -->
                        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:2px;">
                            <small style="color:#888;font-size:0.7rem;">Price (KES)</small>
                            <input type="number"
                                   class="form-control form-control-sm text-end fw-bold"
                                   style="width:100px;border-color:#1565C0;"
                                   value="${item.customPrice || item.product.price}"
                                   min="0"
                                   onchange="updatePrice(${item.product.id}, this.value)"
                                   title="Edit selling price" />
                        </div>
                        <div class="cart-price" id="subtotal_${item.product.id}">
                            KES ${subtotal.toLocaleString()}
                        </div>
                        <button type="button" class="remove-btn"
                                onclick="removeFromCart(${item.product.id})"
                                title="Remove">🗑️</button>
                    </div>`;
        });

        cartContainer.innerHTML = html;
        updateHiddenInputs();

        document.getElementById('grandTotal').textContent =
            'KES ' + total.toLocaleString();
    }

    function toggleMpesa(show) {
        document.getElementById('mpesaDiv').style.display =
            show ? 'block' : 'none';
    }
</script>