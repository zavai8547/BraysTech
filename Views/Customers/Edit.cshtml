@model BraysTech.Models.Customer
@{
    ViewData["Title"] = "Edit Customer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="d-flex align-items-center gap-3 mb-4">
            <a href="/Customers/Index"
               class="btn btn-outline-secondary rounded-pill px-3">
                ← Back
            </a>
            <h4 class="fw-bold mb-0">Edit Customer</h4>
        </div>

        <div class="card border-0 shadow-sm"
             style="border-radius:20px;overflow:hidden;">
            <div class="card-header border-0 p-4"
                 style="background:linear-gradient(135deg,#007A3D,#005C2E);">
                <h5 class="text-white fw-bold mb-0">
                    ✏️ @Model.FullName
                </h5>
            </div>
            <div class="card-body p-4">
                <form method="post" action="/Customers/Edit">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CustomerID"
                           value="@Model.CustomerID" />
                    <input type="hidden" name="TotalPurchases"
                           value="@Model.TotalPurchases" />
                    <input type="hidden" name="TotalSpent"
                           value="@Model.TotalSpent" />
                    <input type="hidden" name="CreatedAt"
                           value="@Model.CreatedAt" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Full Name *
                        </label>
                        <input name="FullName" value="@Model.FullName"
                               class="form-control form-control-lg"
                               style="border-radius:10px;"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Phone Number *
                        </label>
                        <input name="Phone" value="@Model.Phone"
                               class="form-control form-control-lg"
                               style="border-radius:10px;"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Email (optional)
                        </label>
                        <input name="Email" value="@Model.Email"
                               type="email"
                               class="form-control form-control-lg"
                               style="border-radius:10px;" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Notes (optional)
                        </label>
                        <textarea name="Notes"
                                  class="form-control"
                                  rows="3"
                                  style="border-radius:10px;">@Model.Notes</textarea>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit"
                                class="btn btn-lg flex-grow-1 fw-bold"
                                style="background:#007A3D;color:white;
                                       border-radius:12px;">
                            💾 Save Changes
                        </button>
                        <a href="/Customers/Index"
                           class="btn btn-lg btn-outline-secondary rounded-pill px-4">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>