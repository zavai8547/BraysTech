@{
    ViewData["Title"] = "Staff Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var staff = ViewBag.Staff as BraysTech.Models.AppUser;
    var sales = ViewBag.Sales as IEnumerable<BraysTech.Models.PhoneSale>;
    var trend = ViewBag.Trend as IEnumerable<dynamic>;
}

<style>
    .stat-card {
        transition: transform 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-2px);
        }

    .trend-bar-container {
        height: 120px;
        display: flex;
        align-items: flex-end;
        gap: 12px;
    }

    .trend-bar {
        flex: 1;
        text-align: center;
    }

    .bar {
        background: linear-gradient(180deg, #007A3D, #34d399);
        border-radius: 6px 6px 0 0;
        transition: height 0.5s ease;
        min-height: 4px;
        width: 100%;
    }

    .device-badge {
        background: #f0f7f3;
        color: #007A3D;
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
        margin: 2px;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="/Performance/Index"
           class="btn btn-outline-secondary rounded-pill px-3">
            ← Back
        </a>
        <div style="width:52px;height:52px;border-radius:50%;
                    background:linear-gradient(135deg,#007A3D,#009648);
                    color:white;display:flex;align-items:center;
                    justify-content:center;font-weight:800;
                    font-size:1.2rem;">
            @string.Join("", staff!.FullName.Split(' ')
                     .Take(2).Select(w => w[0].ToString().ToUpper()))
        </div>
        <div>
            <h4 class="fw-bold mb-0">@staff.FullName</h4>
            <small class="text-muted">
                @staff.Email • @ViewBag.SelectedMonthName
            </small>
        </div>
    </div>
</div>

<!-- MONTH STATS -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm stat-card"
             style="border-radius:14px;
                    border-left:4px solid #007A3D !important;">
            <div class="card-body">
                <p class="text-muted small mb-1">Sales This Month</p>
                <h3 class="fw-bold mb-0"
                    style="color:#007A3D;">
                    @ViewBag.TotalSales
                </h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm stat-card"
             style="border-radius:14px;
                    border-left:4px solid #1d4ed8 !important;">
            <div class="card-body">
                <p class="text-muted small mb-1">Revenue</p>
                <h4 class="fw-bold mb-0" style="color:#1d4ed8;">
                    KES @(((decimal)ViewBag.TotalRevenue).ToString("N0"))
                </h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm stat-card"
             style="border-radius:14px;
                    border-left:4px solid #b45309 !important;">
            <div class="card-body">
                <p class="text-muted small mb-1">Profit</p>
                <h4 class="fw-bold mb-0" style="color:#b45309;">
                    KES @(((decimal)ViewBag.TotalProfit).ToString("N0"))
                </h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm stat-card"
             style="border-radius:14px;
                    border-left:4px solid #7c3aed !important;">
            <div class="card-body">
                <p class="text-muted small mb-1">Devices Sold</p>
                <h3 class="fw-bold mb-0" style="color:#7c3aed;">
                    @ViewBag.TotalDevices
                </h3>
            </div>
        </div>
    </div>
</div>

<!-- 6 MONTH TREND -->
<div class="card border-0 shadow-sm mb-4"
     style="border-radius:16px;overflow:hidden;">
    <div class="card-header bg-white border-0 pt-3 fw-bold"
         style="color:#007A3D;">
        📊 6 Month Trend
    </div>
    <div class="card-body">
        @if (trend != null && trend.Any())
        {
            var maxRev = 1m;
            var trendList = new List<dynamic>();
            foreach (var t in trend)
            {
                decimal rev = (decimal)t.GetType().GetProperty("revenue").GetValue(t);
                if (rev > maxRev) maxRev = rev;
                trendList.Add(t);
            }

            <div class="trend-bar-container">
                @foreach (var t in trendList)
                {
                    var monthLabel = (string)t.GetType().GetProperty("month").GetValue(t);
                    decimal rev = (decimal)t.GetType().GetProperty("revenue").GetValue(t);
                    int salesCount = (int)t.GetType().GetProperty("sales").GetValue(t);
                    var pct = maxRev > 0 ? (double)(rev / maxRev * 100) : 0;
                    var barH = Math.Max(pct, 4);

                    <div class="trend-bar">
                        <div style="font-size:0.72rem; font-weight:700; color:#007A3D; margin-bottom:4px;">
                            @salesCount
                        </div>
                        <div class="bar" style="height: @barH%;"></div>
                        <div style="font-size:0.72rem; color:#888; margin-top:6px;">
                            @monthLabel
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <div style="font-size: 2rem;">📊</div>
                <p>No sales data available for the last 6 months</p>
            </div>
        }
    </div>
</div>

<!-- SALES LIST -->
<div class="card border-0 shadow-sm"
     style="border-radius:16px;overflow:hidden;">
    <div class="card-header bg-white border-0 pt-3 fw-bold"
         style="color:#007A3D;">
        🧾 Sales This Month (@ViewBag.TotalSales)
    </div>
    <div class="card-body p-0">
        @if (sales == null || !sales.Any())
        {
            <div class="text-center py-4 text-muted">
                No sales this month.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead style="background:#007A3D;">
                        <tr>
                            <th style="color:white; padding:12px 16px; border:none; font-size:0.82rem; background-color:#007A3D;">
                                Date
                            </th>
                            <th style="color:white; padding:12px 16px; border:none; font-size:0.82rem; background-color:#007A3D;">
                                Customer
                            </th>
                            <th style="color:white; padding:12px 16px; border:none; font-size:0.82rem; background-color:#007A3D;">
                                Devices
                            </th>
                            <th style="color:white; padding:12px 16px; border:none; font-size:0.82rem; background-color:#007A3D;">
                                Payment
                            </th>
                            <th style="color:white; padding:12px 16px; border:none; font-size:0.82rem; background-color:#007A3D;">
                                Revenue (KES)
                            </th>
                            <th style="color:white; padding:12px 16px; border:none; font-size:0.82rem; background-color:#007A3D;">
                                Profit (KES)
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in sales)
                        {
                            <tr>
                                <td style="padding:12px 16px; font-size:0.85rem; border-bottom:1px solid #f0f0f0;">
                                    @s.CreatedAt.ToString("dd MMM HH:mm")
                                </td>
                                <td style="padding:12px 16px; font-size:0.85rem; border-bottom:1px solid #f0f0f0;">
                                    @(s.CustomerName ?? "Walk-in")
                                </td>
                                <td style="padding:12px 16px; border-bottom:1px solid #f0f0f0;">
                                    @foreach (var item in s.Items.Take(3))
                                    {
                                        <span class="device-badge">
                                            @item.PhoneName
                                        </span>
                                    }
                                    @if (s.Items.Count > 3)
                                    {
                                        <span class="device-badge">
                                            +@(s.Items.Count - 3) more
                                        </span>
                                    }
                                </td>
                                <td style="padding:12px 16px; border-bottom:1px solid #f0f0f0;">
                                    <span class="badge" style="background:@(s.PaymentMethod.ToString() == "MPesa" ? "#dbeafe" : "#dcfce7"); color:@(s.PaymentMethod.ToString() == "MPesa" ? "#2563eb" : "#16a34a"); padding:4px 10px; border-radius:20px; font-size:0.75rem; font-weight:600;">
                                        @s.PaymentMethod
                                    </span>
                                </td>
                                <td style="padding:12px 16px; border-bottom:1px solid #f0f0f0;">
                                    <strong style="color:#007A3D;">
                                        KES @s.TotalAmount.ToString("N0")
                                    </strong>
                                </td>
                                <td style="padding:12px 16px; border-bottom:1px solid #f0f0f0;">
                                    <strong style="color:#b45309;">
                                        KES @s.TotalProfit.ToString("N0")
                                    </strong>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>