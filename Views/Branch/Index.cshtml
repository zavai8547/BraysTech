@model IEnumerable<BraysTech.Models.Branch>
    @{
    ViewData["Title"] = "Branches";
    Layout = "~/Views/Shared/_Layout.cshtml";
    }

    <style>
        .branch-card {
            border-radius: 16px;
            border: none;
            box-shadow: 0 2px 12px rgba(0,0,0,0.07);
            transition: transform 0.2s, box-shadow 0.2s;
            overflow: hidden;
        }

            .branch-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 24px rgba(0,122,61,0.15);
            }

            .branch-card .card-top {
                background: linear-gradient(135deg, #007A3D, #005C2E);
                padding: 20px;
                color: white;
            }

                .branch-card .card-top h5 {
                    font-weight: 700;
                    margin-bottom: 4px;
                }

                .branch-card .card-top small {
                    opacity: 0.8;
                }

        .stat-pill {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
            border-bottom: 1px solid #f0f0f0;
            font-size: 0.9rem;
        }

            .stat-pill:last-child {
                border-bottom: none;
            }

            .stat-pill .label {
                color: #666;
            }

            .stat-pill .value {
                font-weight: 700;
                color: #007A3D;
            }

        .add-branch-card {
            border-radius: 16px;
            border: 2px dashed #007A3D;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 260px;
            cursor: pointer;
            transition: all 0.2s;
            background: #f9fef9;
            text-decoration: none;
        }

            .add-branch-card:hover {
                background: #e8f5e9;
                border-color: #005C2E;
                transform: translateY(-4px);
            }

            .add-branch-card .inner {
                text-align: center;
                color: #007A3D;
            }

            .add-branch-card .icon {
                font-size: 3rem;
                display: block;
                margin-bottom: 12px;
            }

            .add-branch-card h6 {
                font-weight: 700;
                color: #007A3D;
                margin-bottom: 6px;
            }

            .add-branch-card p {
                font-size: 0.85rem;
                color: #888;
                margin: 0;
            }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 6px;
        }
    </style>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">🏪 Branches</h4>
            <small class="text-muted">
                @Model.Count() branch@(Model.Count() != 1 ? "es" : "")
                — @Model.Count(b => b.IsActive) active
            </small>
        </div>
        @if (User.IsInRole("Admin"))
    {
        <a href="/Branch/Create"
           class="btn btn-success rounded-pill px-4 fw-semibold"
           style="background:#007A3D;border-color:#007A3D;">
            + Add Branch
        </a>
    }
    </div>

    @if (!Model.Any())
{
    <div class="text-center py-5">
        <div style="font-size:4rem;">🏪</div>
        <h5 class="mt-3 fw-bold">No branches yet</h5>
        <p class="text-muted">Add your first branch to get started.</p>
        <a href="/Branch/Create"
           class="btn btn-success rounded-pill px-5 mt-2"
           style="background:#007A3D;border-color:#007A3D;">
            + Add First Branch
        </a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var b in Model)
        {
            var salesThisMonth = b.Sales
                .Where(s => s.CreatedAt >= new DateTime(
                    DateTime.Today.Year, DateTime.Today.Month, 1))
                .Sum(s => s.TotalAmount);

            var salesToday = b.Sales
                .Where(s => s.CreatedAt.Date == DateTime.Today)
                .Sum(s => s.TotalAmount);

            var phonesInStock = b.Stock
                .Count(s => s.Status == BraysTech.Models.PhoneStatus.InStock);

        <div class="col-md-4">
            <div class="branch-card card">
                <div class="card-top">
                    <div class="d-flex justify-content-between
                                    align-items-start">
                        <div>
                            <h5>@b.Name</h5>
                            <small>
                                📍 @(b.Location ?? "No location set")
                            </small>
                            @if (!string.IsNullOrEmpty(b.Phone))
                                {
                            <br />
                            <small>📞 @b.Phone</small>
                                }
                        </div>
                        <span class="badge"
                              style="background:rgba(255,255,255,0.2);
                                         font-size:0.75rem;">
                            <span class="status-dot"
                                  style="background:@(b.IsActive ? "#4ade80" : "#f87171")">
                            </span>
                            @(b.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="stat-pill">
                        <span class="label">📱 Phones in Stock</span>
                        <span class="value">@phonesInStock</span>
                    </div>
                    <div class="stat-pill">
                        <span class="label">👤 Staff Assigned</span>
                        <span class="value">@b.Staff.Count()</span>
                    </div>
                    <div class="stat-pill">
                        <span class="label">💰 Sales Today</span>
                        <span class="value">
                            KES @salesToday.ToString("N0")
                        </span>
                    </div>
                    <div class="stat-pill">
                        <span class="label">📊 This Month</span>
                        <span class="value">
                            KES @salesThisMonth.ToString("N0")
                        </span>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <a href="/Branch/Details/@b.BranchID"
                           class="btn btn-sm flex-grow-1 fw-semibold"
                           style="background:#007A3D;color:white;
                                      border-radius:8px;">
                            View Details
                        </a>
                        @if (User.IsInRole("Admin"))
                            {
                        <a href="/Branch/Edit/@b.BranchID"
                           class="btn btn-sm btn-outline-secondary"
                           style="border-radius:8px;">
                            ✏️
                        </a>
                        <form method="post"
                              action="/Branch/ToggleActive"
                              style="display:inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden"
                                   name="id" value="@b.BranchID" />
                            <button type="submit"
                                    class="btn btn-sm @(b.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                    style="border-radius:8px;">
                                @(b.IsActive ? "⏸" : "▶")
                            </button>
                        </form>
                            }
                    </div>
                </div>
            </div>
        </div>
        }

        @if (User.IsInRole("Admin"))
        {
        <div class="col-md-4">
            <a href="/Branch/Create" class="add-branch-card">
                <div class="inner">
                    <span class="icon">➕</span>
                    <h6>Add New Branch</h6>
                    <p>
                        Expand your business by<br />
                        adding another branch
                    </p>
                </div>
            </a>
        </div>
        }
    </div>
}
