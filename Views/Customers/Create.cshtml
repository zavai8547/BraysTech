@model BraysTech.Models.Customer
@{
    ViewData["Title"] = "Add Customer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="d-flex align-items-center gap-3 mb-4">
            <a href="/Customers/Index"
               class="btn btn-outline-secondary rounded-pill px-3">
                ← Back
            </a>
            <h4 class="fw-bold mb-0">Add New Customer</h4>
        </div>

        <div class="card border-0 shadow-sm"
             style="border-radius:20px;overflow:hidden;">
            <div class="card-header border-0 p-4"
                 style="background:linear-gradient(135deg,#007A3D,#005C2E);">
                <h5 class="text-white fw-bold mb-1">👥 Customer Details</h5>
                <small style="color:rgba(255,255,255,0.7);">
                    Fill in the customer information
                </small>
            </div>
            <div class="card-body p-4">
                <form method="post" action="/Customers/Create">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Full Name <span class="text-danger">*</span>
                        </label>
                        <input name="FullName"
                               class="form-control form-control-lg"
                               placeholder="e.g. John Kamau"
                               style="border-radius:10px;"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Phone Number <span class="text-danger">*</span>
                        </label>
                        <input name="Phone"
                               class="form-control form-control-lg"
                               placeholder="e.g. 0712 345 678"
                               style="border-radius:10px;"
                               required />
                        <small class="text-muted">
                            Must be unique — used to identify the customer
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Email
                            <span class="text-muted fw-normal">
                                (optional)
                            </span>
                        </label>
                        <input name="Email" type="email"
                               class="form-control form-control-lg"
                               placeholder="e.g. john@email.com"
                               style="border-radius:10px;" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Notes
                            <span class="text-muted fw-normal">
                                (optional)
                            </span>
                        </label>
                        <textarea name="Notes"
                                  class="form-control"
                                  rows="3"
                                  style="border-radius:10px;"
                                  placeholder="e.g. VIP customer, prefers Samsung...">
                        </textarea>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit"
                                class="btn btn-lg flex-grow-1 fw-bold"
                                style="background:#007A3D;color:white;
                                       border-radius:12px;">
                            💾 Save Customer
                        </button>
                        <a href="/Customers/Index"
                           class="btn btn-lg btn-outline-secondary rounded-pill px-4">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>