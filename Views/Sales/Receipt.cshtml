@model BraysTech.Models.PhoneSale
@{
    ViewData["Title"] = $"Receipt #{Model.SaleID}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .receipt {
        max-width: 520px;
        margin: 0 auto;
        background: white;
        border-radius: 20px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .receipt-header {
        background: linear-gradient(135deg, #007A3D, #005C2E);
        color: white;
        padding: 32px;
        text-align: center;
    }

        .receipt-header h2 {
            font-size: 1.8rem;
            font-weight: 800;
            margin: 0 0 4px;
        }

        .receipt-header small {
            opacity: 0.8;
        }

    .receipt-body {
        padding: 28px;
    }

    .receipt-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px dashed #e5e7eb;
        font-size: 0.9rem;
    }

        .receipt-row:last-child {
            border: none;
        }

        .receipt-row .label {
            color: #666;
        }

        .receipt-row .value {
            font-weight: 700;
        }

    .receipt-divider {
        border: none;
        border-top: 2px dashed #e5e7eb;
        margin: 16px 0;
    }

    .receipt-total {
        background: #f0f7f3;
        border-radius: 14px;
        padding: 16px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 16px;
    }

        .receipt-total .label {
            font-weight: 700;
            color: #007A3D;
            font-size: 1rem;
        }

        .receipt-total .amount {
            font-size: 2rem;
            font-weight: 800;
            color: #007A3D;
            letter-spacing: -1px;
        }

    .device-line {
        background: #f9fef9;
        border-radius: 10px;
        padding: 12px 14px;
        margin-bottom: 8px;
    }

    .receipt-footer {
        text-align: center;
        padding: 20px 28px 28px;
        color: #aaa;
        font-size: 0.82rem;
        border-top: 1px solid #f0f0f0;
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        .receipt {
            box-shadow: none;
            border-radius: 0;
        }

        body {
            background: white;
        }

        .main-content {
            margin-left: 0 !important;
            padding: 0 !important;
        }

        .topbar, .sidebar, .hamburger {
            display: none !important;
        }
    }
</style>

<!-- ACTION BUTTONS -->
<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div class="d-flex align-items-center gap-3">
        <a href="/Sales/Index"
           class="btn btn-outline-secondary rounded-pill px-3">
            ← Sales History
        </a>
        <h4 class="fw-bold mb-0">✅ Sale Complete!</h4>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()"
                class="btn btn-outline-secondary rounded-pill px-4">
            🖨️ Print Receipt
        </button>
        <a href="/Sales/New"
           class="btn rounded-pill px-4 fw-semibold"
           style="background:#007A3D;color:white;">
            + New Sale
        </a>
    </div>
</div>

<!-- RECEIPT -->
<div class="receipt">
    <div class="receipt-header">
        <div style="font-size:2rem;margin-bottom:8px;">🏪</div>
        <h2>Brays Technologies</h2>
        <small>Smart Retail ERP System</small>
        <div style="margin-top:16px;
                    background:rgba(255,255,255,0.15);
                    border-radius:10px;padding:10px;">
            <div style="font-size:1.1rem;font-weight:700;">
                RECEIPT #@Model.SaleID
            </div>
            <div style="font-size:0.82rem;opacity:0.85;">
                @Model.CreatedAt.ToString("dddd, dd MMMM yyyy — HH:mm")
            </div>
        </div>
    </div>

    <div class="receipt-body">

        <!-- SALE INFO -->
        <div class="receipt-row">
            <span class="label">Branch</span>
            <span class="value">@(Model.Branch?.Name ?? "—")</span>
        </div>
        <div class="receipt-row">
            <span class="label">Served By</span>
            <span class="value">@(Model.Staff?.FullName ?? "—")</span>
        </div>
        <div class="receipt-row">
            <span class="label">Customer</span>
            <span class="value">
                @(Model.CustomerName ?? "Walk-in Customer")
            </span>
        </div>
        @if (!string.IsNullOrEmpty(Model.CustomerPhone))
        {
            <div class="receipt-row">
                <span class="label">Phone</span>
                <span class="value">@Model.CustomerPhone</span>
            </div>
        }
        <div class="receipt-row">
            <span class="label">Payment Method</span>
            <span class="value">@Model.PaymentMethod</span>
        </div>
        @if (!string.IsNullOrEmpty(Model.MpesaCode))
        {
            <div class="receipt-row">
                <span class="label">M-Pesa Code</span>
                <span class="value"
                      style="font-family:monospace;color:#007A3D;">
                    @Model.MpesaCode
                </span>
            </div>
        }

        <hr class="receipt-divider" />

        <!-- DEVICES -->
        <div style="font-weight:700;margin-bottom:12px;
                    font-size:0.85rem;color:#555;">
            DEVICES PURCHASED
        </div>

        @foreach (var item in Model.Items)
        {
            <div class="device-line">
                <div style="font-weight:700;font-size:0.9rem;">
                    @item.PhoneName
                </div>
                <div style="font-size:0.75rem;
                             font-family:monospace;
                             color:#888;margin:3px 0;">
                    IMEI: @item.IMEI
                </div>
                <div style="display:flex;
                             justify-content:space-between;
                             margin-top:6px;">
                    <span style="font-size:0.82rem;color:#666;">
                        Unit Price
                    </span>
                    <span style="font-weight:700;color:#007A3D;">
                        KES @item.SellingPrice.ToString("N0")
                    </span>
                </div>
            </div>
        }

        <hr class="receipt-divider" />

        <!-- TOTALS -->
        <div class="receipt-row">
            <span class="label">Items</span>
            <span class="value">@Model.Items.Count</span>
        </div>
        <div class="receipt-row">
            <span class="label">Subtotal</span>
            <span class="value">
                KES @Model.TotalAmount.ToString("N0")
            </span>
        </div>

        <div class="receipt-total">
            <span class="label">TOTAL PAID</span>
            <span class="amount">
                KES @Model.TotalAmount.ToString("N0")
            </span>
        </div>

    </div>

    <div class="receipt-footer">
        Thank you for choosing Brays Technologies!<br />
        <strong style="color:#007A3D;">
            Brays Technologies Systems
        </strong>
        — Smart Retail ERP
    </div>
</div>