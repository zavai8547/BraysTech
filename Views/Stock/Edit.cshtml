@model BraysTech.Models.IMEIStock
@{
    ViewData["Title"] = "Edit Device";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .form-control:focus, .form-select:focus {
        border-color: #007A3D;
        box-shadow: 0 0 0 3px rgba(0,122,61,0.1);
    }

    .section-divider {
        font-size: 0.75rem;
        font-weight: 700;
        color: #007A3D;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin: 20px 0 12px;
        padding-bottom: 8px;
        border-bottom: 2px solid #e5f0e8;
    }

    .profit-preview {
        background: #f0f7f3;
        border-radius: 12px;
        padding: 14px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 16px 0;
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-7">

        <div class="d-flex align-items-center gap-3 mb-4">
            <a href="/Stock/Index"
               class="btn btn-outline-secondary rounded-pill px-3">
                Back
            </a>
            <h4 class="fw-bold mb-0">Edit Device</h4>
        </div>

        <!-- Device identity card -->
        <div class="card border-0 shadow-sm mb-4"
             style="border-radius:14px;
                    border-left:4px solid #007A3D !important;">
            <div class="card-body py-3">
                <div class="fw-bold fs-6">@Model.PhoneName</div>
                <div style="font-family:monospace;
                             color:#007A3D;font-weight:700;
                             font-size:0.88rem;">
                    IMEI: @Model.IMEI
                </div>
                <small class="text-muted">
                    Added @Model.DateAdded.ToString("dd MMM yyyy")
                    &nbsp;|&nbsp;
                    Status:
                    <strong>@Model.Status.ToString()</strong>
                </small>
            </div>
        </div>

        <div class="card border-0 shadow-sm"
             style="border-radius:20px;overflow:hidden;">
            <div class="card-header border-0 p-4"
                 style="background:linear-gradient(
                            135deg,#007A3D,#005C2E);">
                <h5 class="text-white fw-bold mb-0">
                    Edit Device Details
                </h5>
            </div>
            <div class="card-body p-4">
                <form method="post" action="/Stock/Edit">
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="StockID"
                           value="@Model.StockID" />
                    <input type="hidden"
                           name="Status"
                           value="@((int)Model.Status)" />
                    <input type="hidden"
                           name="DateAdded"
                           value="@Model.DateAdded
                               .ToString(" o")" />
                    <input type="hidden"
                           name="DateSold"
                           value="@Model.DateSold?
                               .ToString(" o")" />

                    <div class="section-divider">
                        Device Information
                    </div>

                    <!-- IMEI Field - Admin editable, Manager locked -->
                    <div class="mt-3">
                        <label class="form-label fw-semibold">
                            IMEI Number
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="text-muted fw-normal small">
                                    (Admin only — editable)
                                </span>
                            }
                            else
                            {
                                <span class="text-muted fw-normal small">
                                    (locked — contact Admin to change)
                                </span>
                            }
                        </label>

                        @if (User.IsInRole("Admin"))
                        {
                            <input name="IMEI"
                                   class="form-control"
                                   style="border-radius:10px;
                                          font-family:monospace;
                                          font-weight:700;
                                          color:#007A3D;
                                          border:2px solid #007A3D;"
                                   value="@Model.IMEI"
                                   maxlength="20"
                                   required />
                            <small class="text-muted">
                                Only change this to correct a typo.
                                IMEI must be unique across all devices.
                            </small>
                        }
                        else
                        {
                            <input type="hidden"
                                   name="IMEI"
                                   value="@Model.IMEI" />
                            <div class="form-control"
                                 style="border-radius:10px;
                                        font-family:monospace;
                                        font-weight:700;
                                        color:#888;
                                        background:var(--input-bg);
                                        cursor:not-allowed;">
                                @Model.IMEI
                            </div>
                            <small class="text-muted">
                                IMEI can only be edited by Admin.
                            </small>
                        }
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Brand
                            </label>
                            <input name="Brand"
                                   value="@Model.Brand"
                                   class="form-control"
                                   style="border-radius:10px;"
                                   list="brandList" />
                            <datalist id="brandList">
                                <option value="Samsung" />
                                <option value="Apple" />
                                <option value="Tecno" />
                                <option value="Infinix" />
                                <option value="Itel" />
                                <option value="Xiaomi" />
                                <option value="Oppo" />
                                <option value="Huawei" />
                                <option value="Nokia" />
                            </datalist>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Model
                            </label>
                            <input name="Model"
                                   value="@Model.Model"
                                   class="form-control"
                                   style="border-radius:10px;" />
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Color
                            </label>
                            <input name="Color"
                                   value="@Model.Color"
                                   class="form-control"
                                   style="border-radius:10px;"
                                   list="colorList" />
                            <datalist id="colorList">
                                <option value="Black" />
                                <option value="White" />
                                <option value="Blue" />
                                <option value="Gold" />
                                <option value="Silver" />
                                <option value="Red" />
                            </datalist>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Storage
                            </label>
                            <input name="Storage"
                                   value="@Model.Storage"
                                   class="form-control"
                                   style="border-radius:10px;"
                                   list="storageList" />
                            <datalist id="storageList">
                                <option value="32GB" />
                                <option value="64GB" />
                                <option value="128GB" />
                                <option value="256GB" />
                                <option value="512GB" />
                            </datalist>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label fw-semibold">
                            Display Name
                        </label>
                        <input name="PhoneName"
                               id="phoneName"
                               value="@Model.PhoneName"
                               class="form-control"
                               style="border-radius:10px;" />
                    </div>

                    <div class="section-divider">Pricing</div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Buying Price (KES)
                            </label>
                            <input name="BuyingPrice"
                                   id="buyingPrice"
                                   type="number"
                                   value="@Model.BuyingPrice"
                                   class="form-control form-control-lg"
                                   style="border-radius:10px;
                                          font-weight:700;"
                                   min="0"
                                   oninput="calcProfit()"
                                   required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Min. Selling Price (KES)
                            </label>
                            <input name="SellingPrice"
                                   id="sellingPrice"
                                   type="number"
                                   value="@Model.SellingPrice"
                                   class="form-control form-control-lg"
                                   style="border-radius:10px;
                                          font-weight:700;
                                          color:#007A3D;"
                                   min="0"
                                   oninput="calcProfit()"
                                   required />
                        </div>
                    </div>

                    <div class="profit-preview">
                        <div>
                            <div style="font-size:0.82rem;
                                         color:#555;">
                                Expected Profit
                            </div>
                            <div id="profitPreview"
                                 style="font-size:1.3rem;
                                         font-weight:800;
                                         color:#007A3D;">
                                KES @((Model.SellingPrice -
                                Model.BuyingPrice)
                                .ToString("N0"))
                            </div>
                        </div>
                        <div style="text-align:right;">
                            <div style="font-size:0.82rem;
                                         color:#555;">
                                Margin
                            </div>
                            <div id="marginPreview"
                                 style="font-size:1.3rem;
                                         font-weight:800;
                                         color:#007A3D;">
                                @(Model.SellingPrice > 0
                                    ? ((Model.SellingPrice -
                                    Model.BuyingPrice) /
                                    Model.SellingPrice *
                                    100).ToString("N1")
                                    : "0")%
                            </div>
                        </div>
                    </div>

                    <div class="section-divider">
                        Supplier and Branch
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Supplier Name
                            </label>
                            <input name="SupplierName"
                                   value="@Model.SupplierName"
                                   class="form-control"
                                   style="border-radius:10px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Branch
                                <span class="text-danger">*</span>
                            </label>
                            <select name="BranchID"
                                    class="form-select"
                                    style="border-radius:10px;"
                                    required>
                                <option value="">
                                    -- Select Branch --
                                </option>
                                @foreach (var b in ViewBag.Branches)
                                {
                                    if (b.BranchID == Model.BranchID)
                                    {
                                        <option value="@b.BranchID"
                                                selected>
                                            @b.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@b.BranchID">
                                            @b.Name
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label fw-semibold">
                            Notes
                        </label>
                        <textarea name="Notes"
                                  class="form-control"
                                  rows="2"
                                  style="border-radius:10px;">@Model.Notes</textarea>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit"
                                class="btn btn-lg flex-grow-1
                                       fw-bold"
                                style="background:#007A3D;
                                       color:white;
                                       border-radius:12px;">
                            Save Changes
                        </button>
                        <a href="/Stock/Index"
                           class="btn btn-lg
                                  btn-outline-secondary
                                  rounded-pill px-4">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const brandInput = document.querySelector('[name="Brand"]');
    const modelInput = document.querySelector('[name="Model"]');
    const phoneNameInput = document.getElementById('phoneName');

    function updatePhoneName() {
        const brand = brandInput.value.trim();
        const model = modelInput.value.trim();
        if (brand || model) {
            phoneNameInput.value =
                (brand + ' ' + model).trim();
        }
    }

    brandInput.addEventListener('input', updatePhoneName);
    modelInput.addEventListener('input', updatePhoneName);

    function calcProfit() {
        const buy = parseFloat(
            document.getElementById('buyingPrice')
                .value) || 0;
        const sell = parseFloat(
            document.getElementById('sellingPrice')
                .value) || 0;
        const profit = sell - buy;
        const margin = sell > 0
            ? (profit / sell * 100) : 0;

        const profitEl = document.getElementById(
            'profitPreview');
        const marginEl = document.getElementById(
            'marginPreview');

        profitEl.textContent =
            'KES ' + profit.toLocaleString();
        profitEl.style.color =
            profit >= 0 ? '#007A3D' : '#dc2626';
        marginEl.textContent = margin.toFixed(1) + '%';
        marginEl.style.color =
            margin >= 0 ? '#007A3D' : '#dc2626';
    }
</script>