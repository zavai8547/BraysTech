@model IEnumerable<BraysTech.Models.Expense>
@{
    ViewData["Title"] = "Expenses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .expense-card {
        background: white;
        border-radius: 16px;
        border: none;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        overflow: hidden;
        margin-bottom: 20px;
    }

    .expense-header {
        background: #007A3D;
        color: white;
        padding: 14px 20px;
        font-weight: 700;
        font-size: 0.9rem;
    }

    .expense-table thead th {
        background: #007A3D;
        color: white;
        font-weight: 600;
        font-size: 0.82rem;
        padding: 12px 14px;
        border: none;
    }

    .expense-table tbody td {
        padding: 12px 14px;
        font-size: 0.86rem;
        border-color: #f0f7f3;
        vertical-align: middle;
    }

    .expense-table tbody tr:hover {
        background: #f9fef9;
    }

    .category-badge {
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Expenses</h4>
        <small class="text-muted">Track and manage all business expenses</small>
    </div>
    <button class="btn fw-semibold rounded-pill px-4"
            style="background:#007A3D;color:white;"
            data-bs-toggle="modal"
            data-bs-target="#addExpenseModal">
        + Add Expense
    </button>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="border-radius:14px; border-left:4px solid #dc2626 !important;">
            <div class="card-body">
                <p class="text-muted small mb-1">Total Expenses</p>
                <h4 class="fw-bold mb-0" style="color:#dc2626;">
                    KES @Model.Sum(e => e.Amount).ToString("N0")
                </h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="border-radius:14px; border-left:4px solid #f59e0b !important;">
            <div class="card-body">
                <p class="text-muted small mb-1">This Month</p>
                <h4 class="fw-bold mb-0" style="color:#f59e0b;">
                    KES @Model.Where(e => e.ExpenseDate.Month == DateTime.Now.Month && e.ExpenseDate.Year == DateTime.Now.Year).Sum(e => e.Amount).ToString("N0")
                </h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="border-radius:14px; border-left:4px solid #8b5cf6 !important;">
            <div class="card-body">
                <p class="text-muted small mb-1">Expense Count</p>
                <h4 class="fw-bold mb-0" style="color:#8b5cf6;">
                    @Model.Count()
                </h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="border-radius:14px; border-left:4px solid #007A3D !important;">
            <div class="card-body">
                <p class="text-muted small mb-1">Avg Expense Value</p>
                <h4 class="fw-bold mb-0" style="color:#007A3D;">
                    KES @(Model.Any() ? Model.Average(e => e.Amount).ToString("N0") : "0")
                </h4>
            </div>
        </div>
    </div>
</div>

<!-- Expenses Table -->
<div class="expense-card">
    <div class="expense-header">All Expense Records</div>
    <div class="table-responsive">
        <table class="table table-hover expense-table mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Branch</th>
                    <th>Recorded By</th>
                    <th>Amount</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var expense in Model)
                {
                    var categoryStyle = expense.Category switch
                    {
                        "Rent" => "background:#fee2e2;color:#dc2626;",
                        "Utilities" => "background:#fef9c3;color:#ca8a04;",
                        "Salaries" => "background:#dbeafe;color:#2563eb;",
                        "Marketing" => "background:#f3e8ff;color:#9333ea;",
                        "Maintenance" => "background:#fef3c7;color:#d97706;",
                        _ => "background:#f0f7f3;color:#007A3D;"
                    };

                    <tr>
                        <td>@expense.ExpenseDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="category-badge" style="@categoryStyle">
                                @expense.Category
                            </span>
                        </td>
                        <td>@expense.Description</td>
                        <td>@(expense.Branch?.Name ?? "All Branches")</td>
                        <td>@expense.RecordedBy</td>
                        <td class="fw-bold" style="color:#dc2626;">
                            KES @expense.Amount.ToString("N0")
                        </td>
                        <td>
                            <form method="post" action="/Expenses/Delete" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@expense.ExpenseID" />
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this expense?')">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No expenses recorded yet. Click "Add Expense" to get started.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ADD EXPENSE MODAL -->
<div class="modal fade" id="addExpenseModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="background:#007A3D;color:white;">
                <h5 class="modal-title">Record New Expense</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/Expenses/Create">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Category *</label>
                        <select name="category" class="form-select" required>
                            <option value="Rent">Rent</option>
                            <option value="Utilities">Utilities</option>
                            <option value="Salaries">Salaries</option>
                            <option value="Marketing">Marketing</option>
                            <option value="Maintenance">Maintenance</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description *</label>
                        <input type="text" name="description" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Amount (KES) *</label>
                        <input type="number" name="amount" class="form-control" step="0.01" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Expense Date *</label>
                        <input type="date" name="expenseDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Branch</label>
                        <select name="branchID" class="form-select">
                            <option value="">All Branches</option>
                            @foreach (var b in ViewBag.Branches)
                            {
                                <option value="@b.BranchID">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Notes</label>
                        <textarea name="notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn" style="background:#007A3D;color:white;">Save Expense</button>
                </div>
            </form>
        </div>
    </div>
</div>