@model BraysTech.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Brays Technologies — Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #007A3D 0%, #005C2E 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        .login-wrapper {
            background: white;
            border-radius: 24px;
            overflow: hidden;
            width: 100%;
            max-width: 900px;
            min-height: 520px;
            display: flex;
            box-shadow: 0 25px 60px rgba(0,0,0,0.3);
        }

        .login-left {
            flex: 1;
            background: linear-gradient(160deg, #007A3D, #005C2E);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 30px;
            position: relative;
            overflow: hidden;
        }

            .login-left::before {
                content: '';
                position: absolute;
                width: 300px;
                height: 300px;
                background: rgba(255,255,255,0.05);
                border-radius: 50%;
                top: -100px;
                left: -100px;
            }

            .login-left h2 {
                color: white;
                font-size: 2rem;
                font-weight: 800;
                text-align: center;
                position: relative;
                z-index: 1;
                text-transform: uppercase;
                letter-spacing: 2px;
                margin-bottom: 12px;
            }

            .login-left p {
                color: #FFD600;
                font-size: 1rem;
                text-align: center;
                position: relative;
                z-index: 1;
                font-weight: 500;
                letter-spacing: 0.5px;
            }

            .login-left .tagline {
                color: rgba(255,255,255,0.85);
                font-size: 0.85rem;
                margin-top: 20px;
                position: relative;
                z-index: 1;
            }

        .login-right {
            flex: 1;
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .login-right h3 {
                color: #007A3D;
                font-weight: 800;
                font-size: 1.8rem;
                margin-bottom: 6px;
            }

            .login-right .subtitle {
                color: #888;
                font-size: 0.9rem;
                margin-bottom: 32px;
            }

        .yellow-line {
            width: 50px;
            height: 4px;
            background: #FFD600;
            border-radius: 2px;
            margin-bottom: 24px;
        }

        .form-control {
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            padding: 12px 16px;
            transition: border-color 0.2s;
        }

            .form-control:focus {
                border-color: #007A3D;
                box-shadow: 0 0 0 0.2rem rgba(0,122,61,0.25);
                outline: none;
            }

        .btn-login {
            background: linear-gradient(135deg, #007A3D, #005C2E);
            border: none;
            border-radius: 12px;
            padding: 14px;
            font-weight: 700;
            color: white;
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .btn-login:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 14px rgba(0,122,61,0.3);
                background: linear-gradient(135deg, #008c46, #006835);
            }

        .password-wrapper {
            position: relative;
        }

        .toggle-pw {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            font-size: 1.2rem;
            opacity: 0.6;
        }

            .toggle-pw:hover {
                opacity: 1;
            }

        .setup-link {
            text-align: center;
            margin-top: 16px;
            font-size: 0.85rem;
            color: #aaa;
        }

            .setup-link a {
                color: #007A3D;
                text-decoration: none;
                font-weight: 600;
            }

                .setup-link a:hover {
                    text-decoration: underline;
                }

        .alert-success {
            background-color: #d4edda;
            border-color: #c3e6cb;
            color: #155724;
            border-radius: 10px;
        }

        .alert-danger {
            background-color: #f8d7da;
            border-color: #f5c6cb;
            color: #721c24;
            border-radius: 10px;
        }

        @@media (max-width: 650px) {
            .login-wrapper {
                flex-direction: column;
            }

            .login-left {
                min-height: 220px;
            }

                .login-left h2 {
                    font-size: 1.5rem;
                }
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-left">
            <!-- Removed image logo -->
            <h2>BRAYS TECHNOLOGIES</h2>
            <p>ERP System</p>
            <div class="tagline">Smart Retail · Multi-Branch · Real-time</div>
        </div>

        <div class="login-right">
            <h3>Staff Login</h3>
            <p class="subtitle">Access your sales, inventory & branch dashboard</p>
            <div class="yellow-line"></div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success mb-3">@TempData["Success"]</div>
            }

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"
                     style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")">
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control" placeholder="your@brays.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="password-wrapper">
                        <input asp-for="Password" class="form-control" id="passwordField" placeholder="Enter your password" />
                        <button type="button" class="toggle-pw" onclick="togglePassword()" title="Show/hide password">
                            👁️
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label" style="font-size:0.9rem; color:#666;">
                        Remember me on this device
                    </label>
                </div>

                <button type="submit" class="btn btn-login w-100 text-white">
                    Secure Login →
                </button>
            </form>

            <div class="setup-link">
                Need help?
                <a href="/Auth/SeedAdmin">System initialization</a>
            </div>
        </div>
    </div>

    <script>
        function togglePassword() {
            const field = document.getElementById('passwordField');
            const btn = document.querySelector('.toggle-pw');
            if (field.type === 'password') {
                field.type = 'text';
                btn.textContent = '🙈';
            } else {
                field.type = 'password';
                btn.textContent = '👁️';
            }
        }
    </script>
</body>
</html>