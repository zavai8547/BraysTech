@{
    ViewData["Title"] = "Daily Report";
    Layout = "~/Views/Shared/_Layout.cshtml";

    DateTime selectedDate = ViewBag.SelectedDate;
    decimal phoneRevenue = ViewBag.PhoneRevenue ?? 0m;
    decimal phoneProfit = ViewBag.PhoneProfit ?? 0m;
    decimal accRevenue = ViewBag.AccRevenue ?? 0m;
    decimal accProfit = ViewBag.AccProfit ?? 0m;
    decimal serviceRevenue =
        ViewBag.ServiceRevenue ?? 0m;
    decimal simRevenue = ViewBag.SimRevenue ?? 0m;
    decimal simProfit = ViewBag.SimProfit ?? 0m;
    decimal totalRevenue = ViewBag.TotalRevenue ?? 0m;
    decimal grossProfit = ViewBag.GrossProfit ?? 0m;
    decimal totalExpenses =
        ViewBag.TotalExpenses ?? 0m;
    decimal netProfit = ViewBag.NetProfit ?? 0m;
    decimal cashTotal = ViewBag.CashTotal ?? 0m;
    decimal mpesaTotal = ViewBag.MpesaTotal ?? 0m;
    decimal cardTotal = ViewBag.CardTotal ?? 0m;
    decimal totalCashDeclared =
        ViewBag.TotalCashDeclared ?? 0m;
    decimal totalMpesaDeclared =
        ViewBag.TotalMpesaDeclared ?? 0m;
    int phoneSalesCount =
        ViewBag.PhoneSalesCount ?? 0;
    int accSalesCount = ViewBag.AccSalesCount ?? 0;
    int servicesCount = ViewBag.ServicesCount ?? 0;
    int simSalesCount = ViewBag.SimSalesCount ?? 0;
    bool isAdmin = ViewBag.IsAdmin ?? false;

    var phoneSales = ViewBag.PhoneSales as
        IEnumerable<BraysTech.Models.PhoneSale>
        ?? Enumerable.Empty<BraysTech.Models.PhoneSale>();
    var accSales = ViewBag.AccSales as
        IEnumerable<BraysTech.Models.AccessorySale>
        ?? Enumerable.Empty<BraysTech.Models.AccessorySale>();
    var services = ViewBag.Services as
        IEnumerable<BraysTech.Models.ServiceRecord>
        ?? Enumerable.Empty<BraysTech.Models.ServiceRecord>();
    var simSales = ViewBag.SimSales as
        IEnumerable<BraysTech.Models.SimCard>
        ?? Enumerable.Empty<BraysTech.Models.SimCard>();
    var expenses = ViewBag.Expenses as
        IEnumerable<BraysTech.Models.Expense>
        ?? Enumerable.Empty<BraysTech.Models.Expense>();
    var cashUps = ViewBag.CashUps as
        IEnumerable<BraysTech.Models.CashUp>
        ?? Enumerable.Empty<BraysTech.Models.CashUp>();
}

<style>
    .report-card {
        background: var(--bg-card);
        border-radius: 16px;
        border: none;
        box-shadow: var(--shadow);
        overflow: hidden;
        margin-bottom: 24px;
    }

    .report-header {
        padding: 14px 20px;
        font-weight: 700;
        font-size: 0.95rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .report-table thead th {
        background: #007A3D;
        color: white;
        padding: 11px 14px;
        border: none;
        font-size: 0.8rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .report-table tbody td {
        padding: 10px 14px;
        vertical-align: middle;
        border-color: var(--border-color);
        font-size: 0.85rem;
    }

    .section-divider {
        background: linear-gradient( 135deg, #007A3D, #005C2E);
        color: white;
        padding: 10px 20px;
        font-weight: 700;
        font-size: 0.88rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        .topbar, .sidebar,
        .hamburger {
            display: none !important;
        }

        .main-content {
            margin: 0 !important;
            padding: 0 !important;
        }

        body {
            background: white !important;
        }
    }
</style>

<div class="d-flex justify-content-between
            align-items-center mb-4 no-print">
    <div>
        <h4 class="fw-bold mb-1">Daily Report</h4>
        <small class="text-muted">
            @selectedDate.ToString("dddd, dd MMMM yyyy")
        </small>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <form method="get" action="/Reports/Daily"
              class="d-flex gap-2">
            <input type="date"
                   name="date"
                   class="form-control"
                   style="border-radius:10px;
                          width:180px;"
                   value="@selectedDate
                       .ToString(" yyyy-MM-dd")"
                   max="@DateTime.Today
                       .ToString(" yyyy-MM-dd")" />
            @if (isAdmin)
            {
                <select name="branchID"
                        class="form-select"
                        style="border-radius:10px;
                               width:180px;">
                    <option value="">All Branches</option>
                    @foreach (var b in ViewBag.Branches)
                    {
                        if (b.BranchID ==
                        ViewBag.SelectedBranch)
                        {
                            <option value="@b.BranchID"
                                    selected>
                                @b.Name
                            </option>
                        }
                        else
                        {
                            <option value="@b.BranchID">
                                @b.Name
                            </option>
                        }
                    }
                </select>
            }
            <button type="submit"
                    class="btn fw-semibold"
                    style="background:#007A3D;
                           color:white;
                           border-radius:10px;">
                View
            </button>
        </form>
        <button onclick="window.print()"
                class="btn btn-outline-secondary
                       rounded-pill px-3">
            🖨️ Print
        </button>
    </div>
</div>

<!-- ── FINANCIAL SUMMARY ───────────────────────── -->
<div class="report-card">
    <div class="section-divider">
        Financial Summary —
        @selectedDate.ToString("dd MMM yyyy")
    </div>
    <div class="p-4">
        <div class="row g-3 mb-3">
            <div class="col-md-2">
                <div style="background:#f0f7f3;
                             border-radius:12px;
                             padding:14px;
                             text-align:center;">
                    <div style="font-size:0.72rem;
                                 color:#888;
                                 text-transform:uppercase;
                                 letter-spacing:0.5px;">
                        Phone Sales
                    </div>
                    <div style="font-weight:800;
                                 color:#007A3D;
                                 font-size:1.1rem;">
                        KES @phoneRevenue.ToString("N0")
                    </div>
                    <div style="font-size:0.72rem;
                                 color:#888;">
                        @phoneSalesCount txns
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div style="background:#f0f0ff;
                             border-radius:12px;
                             padding:14px;
                             text-align:center;">
                    <div style="font-size:0.72rem;
                                 color:#888;
                                 text-transform:uppercase;
                                 letter-spacing:0.5px;">
                        Accessories
                    </div>
                    <div style="font-weight:800;
                                 color:#7c3aed;
                                 font-size:1.1rem;">
                        KES @accRevenue.ToString("N0")
                    </div>
                    <div style="font-size:0.72rem;
                                 color:#888;">
                        @accSalesCount txns
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div style="background:#eff6ff;
                             border-radius:12px;
                             padding:14px;
                             text-align:center;">
                    <div style="font-size:0.72rem;
                                 color:#888;
                                 text-transform:uppercase;
                                 letter-spacing:0.5px;">
                        Services
                    </div>
                    <div style="font-weight:800;
                                 color:#2563eb;
                                 font-size:1.1rem;">
                        KES @serviceRevenue.ToString("N0")
                    </div>
                    <div style="font-size:0.72rem;
                                 color:#888;">
                        @servicesCount records
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div style="background:#f0fdf4;
                             border-radius:12px;
                             padding:14px;
                             text-align:center;">
                    <div style="font-size:0.72rem;
                                 color:#888;
                                 text-transform:uppercase;
                                 letter-spacing:0.5px;">
                        SIM Cards
                    </div>
                    <div style="font-weight:800;
                                 color:#16a34a;
                                 font-size:1.1rem;">
                        KES @simRevenue.ToString("N0")
                    </div>
                    <div style="font-size:0.72rem;
                                 color:#888;">
                        @simSalesCount sold
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div style="background:#fff7ed;
                             border-radius:12px;
                             padding:14px;
                             text-align:center;">
                    <div style="font-size:0.72rem;
                                 color:#888;
                                 text-transform:uppercase;
                                 letter-spacing:0.5px;">
                        Expenses
                    </div>
                    <div style="font-weight:800;
                                 color:#dc2626;
                                 font-size:1.1rem;">
                        KES @totalExpenses.ToString("N0")
                    </div>
                    <div style="font-size:0.72rem;
                                 color:#888;">
                        @expenses.Count() records
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div style="background:#0f172a;
                             border-radius:12px;
                             padding:14px;
                             text-align:center;">
                    <div style="font-size:0.72rem;
                                 color:#94a3b8;
                                 text-transform:uppercase;
                                 letter-spacing:0.5px;">
                        Net Profit
                    </div>
                    <div style="font-weight:800;
                                 color:@(netProfit >= 0
                                     ? "#4ade80"
                                     : "#f87171");
                                 font-size:1.1rem;">
                        KES @netProfit.ToString("N0")
                    </div>
                    <div style="font-size:0.72rem;
                                 color:#94a3b8;">
                        after expenses
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <div style="background:#f8fafc;
                             border-radius:12px;
                             padding:14px;">
                    <div style="font-size:0.75rem;
                                 color:#888;
                                 font-weight:600;
                                 margin-bottom:10px;">
                        TOTAL REVENUE BREAKDOWN
                    </div>
                    <div style="display:flex;
                                 justify-content:space-between;
                                 padding:6px 0;
                                 border-bottom:1px solid
                                     var(--border-color);
                                 font-size:0.85rem;">
                        <span>Phone Sales</span>
                        <span class="fw-bold">
                            KES @phoneRevenue.ToString("N0")
                        </span>
                    </div>
                    <div style="display:flex;
                                 justify-content:space-between;
                                 padding:6px 0;
                                 border-bottom:1px solid
                                     var(--border-color);
                                 font-size:0.85rem;">
                        <span>Accessories</span>
                        <span class="fw-bold">
                            KES @accRevenue.ToString("N0")
                        </span>
                    </div>
                    <div style="display:flex;
                                 justify-content:space-between;
                                 padding:6px 0;
                                 border-bottom:1px solid
                                     var(--border-color);
                                 font-size:0.85rem;">
                        <span>Services</span>
                        <span class="fw-bold">
                            KES @serviceRevenue.ToString("N0")
                        </span>
                    </div>
                    <div style="display:flex;
                                 justify-content:space-between;
                                 padding:6px 0;
                                 border-bottom:1px solid
                                     var(--border-color);
                                 font-size:0.85rem;">
                        <span>SIM Cards</span>
                        <span class="fw-bold">
                            KES @simRevenue.ToString("N0")
                        </span>
                    </div>
                    <div style="display:flex;
                                 justify-content:space-between;
                                 padding:8px 0 4px;
                                 font-size:0.9rem;">
                        <span class="fw-bold">
                            Total Revenue
                        </span>
                        <span class="fw-bold"
                              style="color:#007A3D;">
                            KES @totalRevenue.ToString("N0")
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div style="background:#f8fafc;
                             border-radius:12px;
                             padding:14px;">
                    <div style="font-size:0.75rem;
                                 color:#888;
                                 font-weight:600;
                                 margin-bottom:10px;">
                        PAYMENT METHODS
                    </div>
                    <div style="display:flex;
                                 justify-content:space-between;
                                 padding:6px 0;
                                 border-bottom:1px solid
                                     var(--border-color);
                                 font-size:0.85rem;">
                        <span>Cash</span>
                        <span class="fw-bold"
                              style="color:#007A3D;">
                            KES @cashTotal.ToString("N0")
                        </span>
                    </div>
                    <div style="display:flex;
                                 justify-content:space-between;
                                 padding:6px 0;
                                 border-bottom:1px solid
                                     var(--border-color);
                                 font-size:0.85rem;">
                        <span>M-Pesa</span>
                        <span class="fw-bold"
                              style="color:#2563eb;">
                            KES @mpesaTotal.ToString("N0")
                        </span>
                    </div>
                    <div style="display:flex;
                                 justify-content:space-between;
                                 padding:6px 0;
                                 border-bottom:1px solid
                                     var(--border-color);
                                 font-size:0.85rem;">
                        <span>Card</span>
                        <span class="fw-bold">
                            KES @cardTotal.ToString("N0")
                        </span>
                    </div>
                    @if (cashUps.Any())
                    {
                        <div style="margin-top:10px;
                                     padding-top:8px;
                                     border-top:2px dashed
                                         var(--border-color);
                                     font-size:0.75rem;
                                     color:#888;
                                     font-weight:600;">
                            CASH-UP DECLARED
                        </div>
                        <div style="display:flex;
                                     justify-content:
                                         space-between;
                                     padding:4px 0;
                                     font-size:0.85rem;">
                            <span>Cash in Hand</span>
                            <span class="fw-bold">
                                KES @totalCashDeclared.ToString("N0")
                            </span>
                        </div>
                        <div style="display:flex;
                                     justify-content:
                                         space-between;
                                     padding:4px 0;
                                     font-size:0.85rem;">
                            <span>M-Pesa Float</span>
                            <span class="fw-bold"
                                  style="color:#2563eb;">
                                KES @totalMpesaDeclared.ToString("N0")
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-4">
                <div style="background:#f8fafc;
                             border-radius:12px;
                             padding:14px;">
                    <div style="font-size:0.75rem;
                                 color:#888;
                                 font-weight:600;
                                 margin-bottom:10px;">
                        PROFIT SUMMARY
                    </div>
                    <div style="display:flex;
                                 justify-content:space-between;
                                 padding:6px 0;
                                 border-bottom:1px solid
                                     var(--border-color);
                                 font-size:0.85rem;">
                        <span>Phone Profit</span>
                        <span class="fw-bold">
                            KES @phoneProfit.ToString("N0")
                        </span>
                    </div>
                    <div style="display:flex;
                                 justify-content:space-between;
                                 padding:6px 0;
                                 border-bottom:1px solid
                                     var(--border-color);
                                 font-size:0.85rem;">
                        <span>Accessory Profit</span>
                        <span class="fw-bold">
                            KES @accProfit.ToString("N0")
                        </span>
                    </div>
                    <div style="display:flex;
                                 justify-content:space-between;
                                 padding:6px 0;
                                 border-bottom:1px solid
                                     var(--border-color);
                                 font-size:0.85rem;">
                        <span>SIM Profit</span>
                        <span class="fw-bold">
                            KES @simProfit.ToString("N0")
                        </span>
                    </div>
                    <div style="display:flex;
                                 justify-content:space-between;
                                 padding:6px 0;
                                 border-bottom:1px solid
                                     var(--border-color);
                                 font-size:0.85rem;">
                        <span>Service Revenue</span>
                        <span class="fw-bold">
                            KES @serviceRevenue.ToString("N0")
                        </span>
                    </div>
                    <div style="display:flex;
                                 justify-content:space-between;
                                 padding:6px 0;
                                 border-bottom:2px solid
                                     var(--border-color);
                                 font-size:0.85rem;">
                        <span>Gross Profit</span>
                        <span class="fw-bold"
                              style="color:#007A3D;">
                            KES @grossProfit.ToString("N0")
                        </span>
                    </div>
                    <div style="display:flex;
                                 justify-content:space-between;
                                 padding:6px 0;
                                 font-size:0.85rem;">
                        <span>Expenses</span>
                        <span class="fw-bold"
                              style="color:#dc2626;">
                            -KES @totalExpenses.ToString("N0")
                        </span>
                    </div>
                    <div style="display:flex;
                                 justify-content:space-between;
                                 padding:8px 0 4px;
                                 border-top:2px solid
                                     var(--border-color);
                                 font-size:0.95rem;">
                        <span class="fw-bold">
                            Net Profit
                        </span>
                        <span class="fw-bold"
                              style="color:@(netProfit >= 0
                                     ? "#007A3D"
                                     : "#dc2626");">
                            KES @netProfit.ToString("N0")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>