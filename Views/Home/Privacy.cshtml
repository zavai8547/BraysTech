@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-5" style="font-size: 0.85rem; line-height: 1.6;">

                <h2 class="fw-bold mb-1" style="color:#1565C0; font-size: 1.6rem;">
                    Privacy Policy
                </h2>
                <p class="text-muted mb-4" style="font-size: 0.8rem;">
                    Last updated: @DateTime.Now.ToString("dd MMMM yyyy")
                </p>

                <p style="font-size: 0.85rem;">
                    This Privacy Policy explains how Kujaributuu Carwash & Detailing
                    ("we", "us", "our") collects, uses, and protects your information
                    when you use our management system (kujaributuu.store).
                </p>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3" style="font-size: 1.05rem;">1. Information We Collect</h5>
                <p style="font-size: 0.85rem;">We collect and store the following types of information:</p>
                <ul class="mb-4" style="font-size: 0.85rem;">
                    <li class="mb-2">Customer information: full name, phone number, and email address (optional)</li>
                    <li class="mb-2">Vehicle information: license plate number, make, model, and colour</li>
                    <li class="mb-2">Transaction records: services rendered, amounts, payment method, and M-Pesa confirmation codes</li>
                    <li class="mb-2">Staff accounts: name, email, phone number, and role</li>
                </ul>

                <h5 class="fw-bold mb-3" style="font-size: 1.05rem;">2. How We Use Your Information</h5>
                <p style="font-size: 0.85rem;">Your information is used only for the following purposes:</p>
                <ul class="mb-4" style="font-size: 0.85rem;">
                    <li class="mb-2">Providing and managing carwash and detailing services</li>
                    <li class="mb-2">Processing payments and maintaining accurate financial records</li>
                    <li class="mb-2">Generating business reports and analytics for management</li>
                    <li class="mb-2">Improving customer service for returning customers</li>
                </ul>
                <p style="font-size: 0.85rem;">
                    We do not sell, rent, or share your personal information with any third parties.
                </p>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3" style="font-size: 1.05rem;">3. Data Security</h5>
                <p style="font-size: 0.85rem;">
                    We take data security seriously. This system follows ISO 27001 information
                    security standards. All passwords are stored using strong encryption, and
                    access to data is strictly controlled through role-based permissions.
                    All communication is encrypted using HTTPS.
                </p>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3" style="font-size: 1.05rem;">4. Data Retention</h5>
                <p style="font-size: 0.85rem;">
                    We retain customer and transaction records for as long as necessary for
                    business operations, accounting, and legal compliance with Kenyan law.
                </p>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3" style="font-size: 1.05rem;">5. Your Rights</h5>
                <p style="font-size: 0.85rem;">You have the right to:</p>
                <ul class="mb-4" style="font-size: 0.85rem;">
                    <li class="mb-2">Request access to the personal data we hold about you</li>
                    <li class="mb-2">Request correction of inaccurate or incomplete data</li>
                    <li class="mb-2">Request deletion of your data (subject to legal retention requirements)</li>
                </ul>
                <p style="font-size: 0.85rem;">
                    To exercise any of these rights, please contact the carwash manager directly or via WhatsApp.
                </p>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3" style="font-size: 1.05rem;">6. Cookies</h5>
                <p style="font-size: 0.85rem;">
                    This system uses only essential session cookies to keep you logged in.
                    These cookies expire after 8 hours or when you log out. We do not use
                    tracking or advertising cookies.
                </p>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3" style="font-size: 1.05rem;">7. Compliance</h5>
                <p style="font-size: 0.85rem;">
                    This system is operated in full compliance with the Kenya Data Protection Act, 2019.
                </p>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3" style="font-size: 1.05rem;">8. Contact Us</h5>
                <p style="font-size: 0.85rem;">For any privacy-related questions or requests, please contact:</p>

                <div class="card bg-light border-0 p-3 mt-3" style="font-size: 0.85rem;">
                    <p class="mb-1">Kujaributuu Carwash & Detailing</p>
                    <p class="mb-1">Nairobi, Kenya</p>
                    <p class="mb-0">
                        Powered by WashFlow Management System
                    </p>
                </div>
            </div>
        </div>

        <div class="text-center mb-4">
            <a href="/Dashboard/Index"
               class="btn btn-outline-secondary rounded-pill px-4"
               style="font-size: 0.9rem;">
                ← Back to Dashboard
            </a>
        </div>
    </div>
</div>