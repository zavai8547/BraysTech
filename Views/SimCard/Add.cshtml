@{
    ViewData["Title"] = "Add SIM Cards";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a href="/SimCard/Index"
               class="btn btn-outline-secondary rounded-pill px-3">
                Back
            </a>
            <h4 class="fw-bold mb-0">Add SIM Cards</h4>
        </div>

        <div class="card border-0 shadow-sm"
             style="border-radius:20px;overflow:hidden;">
            <div class="card-header border-0 p-4"
                 style="background:linear-gradient(
                            135deg,#007A3D,#005C2E);">
                <h5 class="text-white fw-bold mb-0">
                    Add SIM Card Stock
                </h5>
                <small style="color:rgba(255,255,255,0.75);">
                    Add Safaricom, Airtel or Telkom SIMs
                </small>
            </div>
            <div class="card-body p-4">
                <form method="post" action="/SimCard/Add">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Network *
                        </label>
                        <select name="network"
                                class="form-select"
                                style="border-radius:10px;"
                                required>
                            <option value="0">Safaricom</option>
                            <option value="1">Airtel</option>
                            <option value="2">Telkom</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Quantity to Add *
                        </label>
                        <input type="number"
                               name="quantity"
                               class="form-control"
                               style="border-radius:10px;"
                               min="1"
                               value="1"
                               required />
                        <small class="text-muted">
                            Add multiple SIMs of the same
                            network at once
                        </small>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">
                                Buying Price (KES)
                            </label>
                            <input type="number"
                                   name="buyingPrice"
                                   class="form-control"
                                   style="border-radius:10px;"
                                   min="0"
                                   value="0" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">
                                Selling Price (KES) *
                            </label>
                            <input type="number"
                                   name="sellingPrice"
                                   class="form-control"
                                   style="border-radius:10px;
                                          color:#007A3D;
                                          font-weight:700;"
                                   min="0"
                                   required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Branch *
                        </label>
                        <select name="branchID"
                                class="form-select"
                                style="border-radius:10px;"
                                required>
                            <option value="">
                                -- Select Branch --
                            </option>
                            @foreach (var b in ViewBag.Branches)
                            {
                                <option value="@b.BranchID">
                                    @b.Name
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Notes (optional)
                        </label>
                        <input type="text"
                               name="notes"
                               class="form-control"
                               style="border-radius:10px;"
                               placeholder="e.g. Batch from supplier" />
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit"
                                class="btn btn-lg flex-grow-1 fw-bold"
                                style="background:#007A3D;
                                       color:white;
                                       border-radius:12px;">
                            Add to Stock
                        </button>
                        <a href="/SimCard/Index"
                           class="btn btn-lg btn-outline-secondary
                                  rounded-pill px-4">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>