@model BraysTech.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #f59e0b !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small mb-1">Phones in Stock</p>
                        <h2 class="fw-bold mb-0">@Model.TotalPhonesInStock</h2>
                    </div>
                    <div style="font-size:2.5rem;">📱</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #3b82f6 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small mb-1">Total Staff</p>
                        <h2 class="fw-bold mb-0">@Model.TotalStaff</h2>
                    </div>
                    <div style="font-size:2.5rem;">👥</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #10b981 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small mb-1">Sales Today</p>
                        <h2 class="fw-bold mb-0">@Model.SalesToday</h2>
                    </div>
                    <div style="font-size:2.5rem;">🛒</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #8b5cf6 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small mb-1">Branches</p>
                        <h2 class="fw-bold mb-0">@Model.TotalBranches</h2>
                    </div>
                    <div style="font-size:2.5rem;">🏢</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body">
                <p class="mb-1 opacity-75">Revenue Today</p>
                <h3 class="fw-bold">KES @Model.RevenueTodayAll.ToString("N0")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body">
                <p class="mb-1 opacity-75">Revenue This Month</p>
                <h3 class="fw-bold">KES @Model.RevenueThisMonthAll.ToString("N0")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-dark text-white">
            <div class="card-body">
                <p class="mb-1 opacity-75">Profit This Month</p>
                <h3 class="fw-bold">KES @Model.ProfitThisMonth.ToString("N0")</h3>
            </div>
        </div>
    </div>
</div>

<div class="mb-4">
    <a href="/Sales/New" class="btn btn-primary btn-lg px-5 rounded-pill shadow">
        ➕ New Phone Sale
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold border-0 pt-3">
        📊 Branch Performance
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Branch Name</th>
                    <th>Staff Count</th>
                    <th>In Stock</th>
                    <th>Today's Revenue</th>
                    <th>Monthly Revenue</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.BranchSummaries)
                {
                    <tr>
                        <td><strong>@b.BranchName</strong></td>
                        <td>@b.StaffCount</td>
                        <td>@b.PhonesInStock</td>
                        <td>KES @b.RevenueToday.ToString("N0")</td>
                        <td>KES @b.RevenueThisMonth.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>