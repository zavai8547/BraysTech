<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Brays Technologies — @ViewData["Title"]</title>

    <script>
        (function () {
            const t = localStorage.getItem('brays_theme');
            if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        })();
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --bg-body: #F3F8F5;
            --bg-card: #ffffff;
            --bg-topbar: #ffffff;
            --text-primary: #0f172a;
            --text-muted: #6b7280;
            --border-color: #e5f0e8;
            --input-bg: #ffffff;
            --input-text: #0f172a;
            --input-border: #d1d5db;
            --table-hover: #f9fef9;
            --shadow: 0 2px 12px rgba(0,0,0,0.06);
        }

        [data-theme="dark"] {
            --bg-body: #0f172a;
            --bg-card: #1e293b;
            --bg-topbar: #1e293b;
            --text-primary: #e2e8f0;
            --text-muted: #94a3b8;
            --border-color: #334155;
            --input-bg: #0f172a;
            --input-text: #e2e8f0;
            --input-border: #334155;
            --table-hover: #1a2d1a;
            --shadow: 0 2px 12px rgba(0,0,0,0.3);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--bg-body);
            color: var(--text-primary);
            font-family: 'Segoe UI', sans-serif;
            overflow-x: hidden;
            transition: background 0.3s, color 0.3s;
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            background: linear-gradient(180deg, #007A3D 0%, #005C2E 100%);
            position: fixed;
            left: 0;
            top: 0;
            z-index: 200;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            transition: 0.3s ease;
            box-shadow: 4px 0 20px rgba(0,0,0,0.08);
        }

            .sidebar::-webkit-scrollbar {
                width: 4px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.2);
                border-radius: 10px;
            }

        .brand {
            padding: 22px 22px 18px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

            .brand h3 {
                margin: 0;
                color: white;
                font-size: 20px;
                font-weight: 800;
                letter-spacing: .4px;
            }

            .brand span {
                color: rgba(255,255,255,0.7);
                font-size: 12px;
            }

        .nav-wrapper {
            padding-bottom: 20px;
        }

        .nav-section {
            padding: 20px 20px 8px;
            color: rgba(255,255,255,0.45);
            font-size: 11px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            font-weight: 700;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            color: rgba(255,255,255,0.88);
            text-decoration: none;
            padding: 11px 20px;
            font-size: 14px;
            transition: 0.2s ease;
            border-left: 3px solid transparent;
            margin: 2px 0;
        }

            .nav-link:hover, .nav-link.active {
                background: rgba(255,255,255,0.12);
                color: white;
                border-left: 3px solid #ffffff;
                padding-left: 26px;
            }

        .nav-icon {
            width: 22px;
            text-align: center;
            font-size: 16px;
        }

        .coming-soon {
            font-size: 10px;
            background: rgba(255,255,255,0.15);
            padding: 2px 7px;
            border-radius: 20px;
            margin-left: auto;
            color: rgba(255,255,255,0.9);
            font-weight: 700;
        }

        .sidebar-footer {
            margin-top: auto;
            padding: 18px 20px;
            border-top: 1px solid rgba(255,255,255,0.1);
            color: rgba(255,255,255,0.65);
            font-size: 12px;
        }

            .sidebar-footer small {
                display: block;
                margin-top: 5px;
                opacity: .7;
            }

        .topbar {
            height: auto;
            min-height: 72px;
            background: var(--bg-topbar);
            margin-left: 260px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 28px;
            border-bottom: 3px solid #007A3D;
            position: sticky;
            top: 0;
            z-index: 150;
            box-shadow: var(--shadow);
            transition: background 0.3s;
        }

        .page-title {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .page-title h5 {
                margin: 0;
                color: #007A3D;
                font-weight: 800;
            }

            .page-title small {
                color: var(--text-muted);
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .theme-btn {
            border: none;
            background: var(--border-color);
            width: 40px;
            height: 40px;
            border-radius: 10px;
            cursor: pointer;
            font-size: 18px;
            transition: 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .theme-btn:hover {
                opacity: 0.8;
            }

        .user-btn {
            border-radius: 14px;
            padding: 8px 14px;
            border: 1px solid var(--border-color);
            background: var(--bg-card);
            color: var(--text-primary);
            font-weight: 600;
        }

        .main-content {
            margin-left: 260px;
            padding: 24px;
        }

        .card {
            background: var(--bg-card) !important;
            color: var(--text-primary) !important;
        }

        .table {
            color: var(--text-primary) !important;
        }

        .table-light th {
            background: var(--border-color) !important;
            color: var(--text-primary) !important;
        }

        .form-control, .form-select {
            background: var(--input-bg) !important;
            color: var(--input-text) !important;
            border-color: var(--input-border) !important;
        }

            .form-control:focus, .form-select:focus {
                border-color: #007A3D !important;
                box-shadow: 0 0 0 3px rgba(0,122,61,0.15) !important;
            }

        .dropdown-menu {
            background: var(--bg-card) !important;
            border-color: var(--border-color) !important;
        }

        .dropdown-item {
            color: var(--text-primary) !important;
        }

            .dropdown-item:hover {
                background: var(--border-color) !important;
            }

        .modal-content {
            background: var(--bg-card) !important;
            color: var(--text-primary) !important;
        }

        .toast-container-custom {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .toast-box {
            min-width: 320px;
            background: var(--bg-card);
            border-radius: 14px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            animation: slideIn .3s ease;
            color: var(--text-primary);
        }

        .toast-success {
            border-left: 5px solid #16A34A;
        }

        .toast-error {
            border-left: 5px solid #DC2626;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(20px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .hamburger {
            display: none;
            position: fixed;
            top: 14px;
            left: 12px;
            z-index: 999;
            border: none;
            background: #007A3D;
            color: white;
            border-radius: 10px;
            padding: 10px 13px;
            font-size: 20px;
        }

        .overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.5);
            z-index: 180;
        }

        @@media(max-width: 1024px) {
            .hamburger {
                display: block;
            }

            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

                    .sidebar.open .brand {
                        padding-left: 65px;
                    }

            .overlay.open {
                display: block;
            }

            .topbar, .main-content {
                margin-left: 0;
            }

            .topbar {
                padding-left: 70px;
                padding-top: 14px;
                padding-bottom: 14px;
            }

            .page-title small {
                display: none;
            }

            .page-title h5 {
                font-size: 18px;
            }

            .main-content {
                padding: 16px;
            }

            .topbar-right {
                gap: 8px;
            }

            .user-btn {
                font-size: 12px;
                padding: 6px 10px;
            }
        }
    </style>
</head>

<body>

    <button class="hamburger" onclick="toggleSidebar()">☰</button>
    <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>

    <div class="toast-container-custom">
        @if (TempData["Success"] != null)
        {
            <div class="toast-box toast-success" id="toastSuccess">
                <div style="font-size:20px;">✅</div>
                <div style="flex:1;">@TempData["Success"]</div>
                <button onclick="this.parentElement.remove()"
                        style="border:none;background:none;font-size:18px;color:#999;">
                    ×
                </button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="toast-box toast-error" id="toastError">
                <div style="font-size:20px;">❌</div>
                <div style="flex:1;">@TempData["Error"]</div>
                <button onclick="this.parentElement.remove()"
                        style="border:none;background:none;font-size:18px;color:#999;">
                    ×
                </button>
            </div>
        }
    </div>

    <aside class="sidebar" id="sidebar">
        <div class="brand">
            <h3>Brays Technologies</h3>
            <span>Smart Retail ERP System</span>
        </div>

        <div class="nav-wrapper">

            <div class="nav-section">Main</div>
            <a href="/Dashboard/Index"
               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <span class="nav-icon">📊</span> Dashboard
            </a>

            <div class="nav-section">Sales &amp; POS</div>
            <a href="/Sales/New" class="nav-link">
                <span class="nav-icon">📱</span> New Phone Sale
            </a>
            <a href="/Sales/Index" class="nav-link">
                <span class="nav-icon">🧾</span> Phone Sales History
            </a>
            <a href="/Receipts/Index" class="nav-link">
                <span class="nav-icon">🖨️</span> Receipts
            </a>
            <a href="/Customers/Index" class="nav-link">
                <span class="nav-icon">👥</span> Customers
            </a>

            <div class="nav-section">Inventory</div>
            <a href="/Stock/Index" class="nav-link">
                <span class="nav-icon">📦</span> Phone Stock
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <a href="/Stock/Add" class="nav-link">
                    <span class="nav-icon">➕</span> Add IMEI Device
                </a>
                <a href="/Stock/Faulty" class="nav-link">
                    <span class="nav-icon">⚠️</span> Faulty Devices
                </a>
            }

            <div class="nav-section">Accessories</div>
            <a href="/Accessories/Index" class="nav-link">
                <span class="nav-icon">🔌</span> Accessories Stock
            </a>
            <a href="/Accessories/NewSale" class="nav-link">
                <span class="nav-icon">🛒</span> Sell Accessory
            </a>
            <a href="/Accessories/Sales" class="nav-link">
                <span class="nav-icon">📋</span> Accessory Sales
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <a href="/Accessories/Add" class="nav-link">
                    <span class="nav-icon">➕</span> Add Accessory
                </a>
            }

            <div class="nav-section">SIM Cards</div>
            <a href="/SimCard/Index" class="nav-link">
                <span class="nav-icon">📶</span> SIM Card Stock
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <a href="/SimCard/Add" class="nav-link">
                    <span class="nav-icon">➕</span> Add SIM Cards
                </a>
            }

            <div class="nav-section">Services</div>
            <a href="/Services/Index" class="nav-link">
                <span class="nav-icon">🔧</span> Service Records
            </a>
            <a href="/Services/New" class="nav-link">
                <span class="nav-icon">➕</span> New Service
            </a>

            <div class="nav-section"> M-Pesa</div>
            <a href="/CashUp/New" class="nav-link">
                <span class="nav-icon">💵</span> Submit Mpesa sales
            </a>
            <a href="/CashUp/MyHistory" class="nav-link">
                <span class="nav-icon">📜</span> My Mpesa submission History
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))

            {
                <a href="/CashUp/Overview" class="nav-link">
                    <span class="nav-icon">📊</span> Mpesa Overview
                </a>
            }

            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <div class="nav-section">Branch Management</div>
                <a href="/Branch/Index" class="nav-link">
                    <span class="nav-icon">🏪</span> Branches
                </a>
                <a href="/Performance/Index" class="nav-link">
                    <span class="nav-icon">📈</span> Staff Performance
                </a>
                <a href="/Transfer/Index" class="nav-link">
                    <span class="nav-icon">🔄</span> Stock Transfers
                </a>
            }

            <div class="nav-section">Finance</div>
            <a href="/Expenses/Index" class="nav-link">
                <span class="nav-icon">💰</span> Expenses
            </a>
            <a href="/Reports/Daily" class="nav-link">
                <span class="nav-icon">📅</span> Daily Reports
            </a>
            <a href="/Reports/Monthly" class="nav-link">
                <span class="nav-icon">📊</span> Monthly Reports
            </a>

            @if (User.IsInRole("Admin"))
            {
                <div class="nav-section">Administration</div>
                <a href="/Staff/Index" class="nav-link">
                    <span class="nav-icon">👤</span> Staff Accounts
                </a>
                <a href="/Audit/Index" class="nav-link">
                    <span class="nav-icon">📋</span> Activity Logs
                </a>
                <a href="/Mpesa/Performance" class="nav-link">
                    <span class="nav-icon">📶</span>
                    M-Pesa Performance
                </a>
                <a href="/Settings/Index" class="nav-link">
                    <span class="nav-icon">⚙️</span> System Settings
                </a>

                <div class="nav-section">Phase 2</div>
                <!-- Removed: Stock Transfers coming soon link - now real and moved to Branch Management -->
                <a href="/Home/ComingSoon?feature=Supplier+Management"
                   class="nav-link" style="opacity:0.65;">
                    <span class="nav-icon">📦</span> Suppliers
                    <span class="coming-soon">SOON</span>
                </a>
                <a href="/Home/ComingSoon?feature=M-KOPA+Tracking"
                   class="nav-link" style="opacity:0.65;">
                    <span class="nav-icon">💳</span> M-KOPA Tracking
                    <span class="coming-soon">SOON</span>
                </a>
            }

        </div>

        <div class="sidebar-footer">
            Brays Technologies ERP v1.1.2
            <small>Multi-Branch Phone Shop System</small>
        </div>
    </aside>

    <header class="topbar">
        <div class="page-title">
            <h5>@ViewData["Title"]</h5>
            <small>Manage sales, inventory, staff and branch operations</small>
        </div>
        <div class="topbar-right">
            <button class="theme-btn" id="themeBtn"
                    onclick="toggleTheme()"
                    title="Toggle dark mode">
                🌙
            </button>
            <div class="dropdown">
                <button class="user-btn dropdown-toggle"
                        data-bs-toggle="dropdown">
                    👤 @User.Identity!.Name
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                    <li>
                        <a class="dropdown-item"
                           href="/Auth/ChangePassword">
                            🔑 Change Password
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-controller="Auth"
                              asp-action="Logout"
                              method="post">
                            <button type="submit"
                                    class="dropdown-item text-danger">
                                🚪 Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function applyTheme(theme) {
            if (theme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
                const btn = document.getElementById('themeBtn');
                if (btn) btn.textContent = '☀️';
            } else {
                document.documentElement.removeAttribute('data-theme');
                const btn = document.getElementById('themeBtn');
                if (btn) btn.textContent = '🌙';
            }
        }
        function toggleTheme() {
            const current = localStorage.getItem('brays_theme') || 'light';
            const next = current === 'dark' ? 'light' : 'dark';
            localStorage.setItem('brays_theme', next);
            applyTheme(next);
        }
        applyTheme(localStorage.getItem('brays_theme') || 'light');

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('overlay').classList.toggle('open');
        }

        document.addEventListener('DOMContentLoaded', function () {
            ['toastSuccess', 'toastError'].forEach(function (id) {
                const el = document.getElementById(id);
                if (el) {
                    setTimeout(function () {
                        el.style.transition = '0.3s';
                        el.style.opacity = '0';
                        setTimeout(function () { el.remove(); }, 300);
                    }, 4000);
                }
            });
        });
    </script>

</body>
</html>