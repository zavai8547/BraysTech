@model BraysTech.Models.PhoneSale
@{
    ViewData["Title"] = $"Sale #{Model.SaleID}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="/Sales/Index"
           class="btn btn-outline-secondary rounded-pill px-3">
            ← Back
        </a>
        <div>
            <h4 class="fw-bold mb-0">Sale #@Model.SaleID</h4>
            <small class="text-muted">
                @Model.CreatedAt.ToString("dddd, dd MMMM yyyy — HH:mm")
            </small>
        </div>
    </div>
    <span class="badge fs-6"
          style="background:@(Model.PaymentMethod.ToString() == "Cash" ? "#dcfce7;color:#16a34a" : Model.PaymentMethod.ToString() == "MPesa" ? "#fef9c3;color:#ca8a04" : "#dbeafe;color:#2563eb")">
        @Model.PaymentMethod
    </span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm"
             style="border-radius:16px;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"
                    style="color:#007A3D;">
                    📋 Sale Information
                </h6>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Customer</span>
                    <strong>
                        @(Model.CustomerName ?? "Walk-in Customer")
                    </strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Phone</span>
                    <strong>
                        @(Model.CustomerPhone ?? "—")
                    </strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Branch</span>
                    <strong>@(Model.Branch?.Name ?? "—")</strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Sold By</span>
                    <strong>@(Model.Staff?.FullName ?? "—")</strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Payment</span>
                    <strong>@Model.PaymentMethod</strong>
                </div>
                @if (!string.IsNullOrEmpty(Model.MpesaCode))
                {
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">M-Pesa Code</span>
                        <strong style="font-family:monospace;color:#007A3D;">
                            @Model.MpesaCode
                        </strong>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Notes</span>
                        <span>@Model.Notes</span>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100"
             style="border-radius:16px;
                    background:linear-gradient(135deg,#007A3D,#005C2E);">
            <div class="card-body p-4 text-white">
                <h6 class="fw-bold mb-3 opacity-75">
                    💰 Financial Summary
                </h6>
                <div class="d-flex justify-content-between py-2"
                     style="border-bottom:1px solid rgba(255,255,255,0.15)">
                    <span class="opacity-75">Total Amount</span>
                    <strong class="fs-5">
                        KES @Model.TotalAmount.ToString("N0")
                    </strong>
                </div>
                <div class="d-flex justify-content-between py-2"
                     style="border-bottom:1px solid rgba(255,255,255,0.15)">
                    <span class="opacity-75">Cost of Goods</span>
                    <strong>
                        KES @((Model.TotalAmount - Model.TotalProfit)
                        .ToString("N0"))
                    </strong>
                </div>
                <div class="d-flex justify-content-between py-3 mt-2 rounded px-3"
                     style="background:rgba(255,255,255,0.12)">
                    <span class="fw-bold">Net Profit</span>
                    <strong class="fs-4">
                        KES @Model.TotalProfit.ToString("N0")
                    </strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ITEMS -->
<div class="card border-0 shadow-sm"
     style="border-radius:16px;overflow:hidden;">
    <div class="card-header bg-white border-0 pt-3 pb-0 px-4">
        <h6 class="fw-bold" style="color:#007A3D;">
            📱 Phones in This Sale
        </h6>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead style="background:#007A3D;">
                <tr>
                    <th style="color:white;padding:14px 16px;
                               font-weight:600;border:none;">
                        Phone
                    </th>
                    <th style="color:white;padding:14px 16px;
                               font-weight:600;border:none;">
                        IMEI
                    </th>
                    <th style="color:white;padding:14px 16px;
                               font-weight:600;border:none;">
                        Buying Price
                    </th>
                    <th style="color:white;padding:14px 16px;
                               font-weight:600;border:none;">
                        Selling Price
                    </th>
                    <th style="color:white;padding:14px 16px;
                               font-weight:600;border:none;">
                        Profit
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td style="padding:14px 16px;">
                            <div class="fw-semibold">
                                @item.PhoneName
                            </div>
                        </td>
                        <td style="padding:14px 16px;">
                            <span style="font-family:monospace;
                                         background:#f0f7f3;
                                         color:#007A3D;
                                         padding:3px 10px;
                                         border-radius:8px;
                                         font-size:0.85rem;
                                         font-weight:600;">
                                @item.IMEI
                            </span>
                        </td>
                        <td style="padding:14px 16px;">
                            KES @item.BuyingPrice.ToString("N0")
                        </td>
                        <td style="padding:14px 16px;">
                            <strong style="color:#007A3D;">
                                KES @item.SellingPrice.ToString("N0")
                            </strong>
                        </td>
                        <td style="padding:14px 16px;">
                            <strong style="color:#b45309;">
                                KES @item.Profit.ToString("N0")
                            </strong>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>